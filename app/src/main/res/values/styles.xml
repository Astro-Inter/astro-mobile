<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PopupCloseButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_login_icon_button</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_dialog_close</item>
    </style>

    <style name="AccessKeyDigitInput">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">75dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_access_key_digit</item>
        <item name="android:fontFamily">@font/montserrat_family</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:padding">0dp</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/astro_light_background</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">24sp</item>
    </style>
</resources>
