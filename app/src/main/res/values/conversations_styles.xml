<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ConversationsFilter">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">35dp</item>
        <item name="android:background">@drawable/bg_conversations_filter</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/montserrat_family</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">@color/astro_light_background</item>
        <item name="android:textSize">@dimen/employee_home_caption_text_size</item>
    </style>

    <style name="ConversationsNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">@dimen/employee_home_nav_height</item>
        <item name="android:background">@drawable/bg_shared_nav_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ConversationsNavLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:fontFamily">@font/montserrat_family</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/nav_item_tint</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:textSize">@dimen/employee_home_caption_text_size</item>
    </style>
</resources>
