<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ManagerHomeText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_family</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/astro_light_background</item>
        <item name="android:textSize">@dimen/employee_home_body_text_size</item>
    </style>
    <style name="ManagerHomeText.Heading">
        <item name="android:textSize">@dimen/employee_home_heading_text_size</item>
    </style>
    <style name="ManagerHomeText.Subtitle">
        <item name="android:textColor">@color/astro_input_hint</item>
        <item name="android:layout_marginTop">5dp</item>
    </style>
    <style name="ManagerHomeIcon" parent="">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/astro_light_background</item>
    </style>
    <style name="ManagerHomeSection" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">30dp</item>
        <item name="android:layout_marginEnd">30dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:background">@drawable/bg_access_key_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">30dp</item>
        <item name="android:paddingEnd">30dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="ManagerHomeMore" parent="ManagerHomeText">
        <item name="android:minHeight">80dp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/bg_home_row_ripple</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:text">@string/employee_home_more</item>
    </style>
    <style name="ManagerHomeDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">21dp</item>
        <item name="android:background">@drawable/bg_home_divider</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
