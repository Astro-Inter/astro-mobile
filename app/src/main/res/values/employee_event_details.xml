<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="employee_event_details_title">Detalhes do evento</string>
    <string name="employee_event_urgent">Urgente!</string>
    <string name="employee_event_deadline_message">Prazo limite: %1$s</string>
    <string name="employee_event_about">Sobre o evento</string>
    <string name="employee_event_attachments">Anexos do evento</string>
    <string name="employee_event_view_attachment">Visualizar anexo</string>
    <string name="employee_event_deadline_label">Prazo limite:</string>
    <string name="employee_event_validity_label">Validade:</string>
    <string name="employee_event_completion_mode_label">Modo de conclusão:</string>
    <string name="employee_event_completion_mode_mock">Autodeclaração</string>
    <string name="employee_event_sender_label">Enviado por:</string>
    <string name="employee_event_sender_mock">Tyler, the Creator</string>
    <string name="employee_event_evidence_filename">print_certificado.pdf</string>
    <string name="employee_event_add_evidence">Anexar evidência</string>
    <string name="employee_event_remove_evidence">Remover evidência de exemplo</string>
    <string name="employee_event_complete">Marcar como concluído</string>
    <string name="employee_event_conclusion">Você concluiu um evento!</string>
    <string name="employee_event_attachment_mock">O anexo é apenas uma referência visual neste protótipo.</string>
    <string name="employee_event_evidence_mock">Evidência de exemplo. Nenhum arquivo foi enviado.</string>
    <color name="employee_event_urgent_background">#33FF787A</color>

    <style name="EmployeeEventDetailsText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_family</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/astro_light_background</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="EmployeeEventDetailsLabel" parent="EmployeeEventDetailsText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>
    <style name="EmployeeEventDetailsValue" parent="EmployeeEventDetailsLabel">
        <item name="android:gravity">end</item>
    </style>
    <style name="EmployeeEventDetailsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:baselineAligned">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">30dp</item>
        <item name="android:paddingVertical">20dp</item>
    </style>
    <style name="EmployeeEventDetailsIcon">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/astro_primary_purple</item>
    </style>
    <style name="EmployeeEventDetailsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">21dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_home_divider</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="EmployeeEventDetailsButton" parent="EmployeeEventDetailsText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">48dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:background">@drawable/bg_flow_choice_secondary_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
