<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/astro_button_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape><solid android:color="@color/astro_primary_purple" /><corners android:radius="18dp" /></shape>
            </item>
            <item>
                <shape><solid android:color="@color/astro_light_background" /><corners android:radius="18dp" /></shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape><solid android:color="@android:color/white" /><corners android:radius="18dp" /></shape>
    </item>
</ripple>
