<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/astro_button_ripple">
    <item>
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@color/astro_dark_background" />
            <stroke android:width="1dp" android:color="#FF4D4D" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</ripple>
