<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Astromobile" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorAccent">@color/astro_light_background</item>
        <item name="android:navigationBarColor">@color/astro_dark_background</item>
        <item name="android:statusBarColor">@color/purple_gray</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Astromobile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen_icon</item>
        <item name="windowSplashScreenBackground">@color/astro_dark_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Astromobile</item>
    </style>
</resources>
