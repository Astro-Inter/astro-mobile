<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="45dp" android:paddingEnd="12dp" android:paddingBottom="16dp">
    <LinearLayout android:id="@+id/indicator_human_chat_typing" android:layout_width="wrap_content"
        android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="21dp" android:background="@drawable/bg_chat_assistant"
        android:accessibilityLiveRegion="polite" android:contentDescription="@string/human_chat_typing">
        <View android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="5dp"
            android:background="@drawable/bg_human_typing_dot" android:importantForAccessibility="no" />
        <View android:layout_width="5dp" android:layout_height="5dp" android:layout_marginEnd="5dp"
            android:background="@drawable/bg_human_typing_dot" android:importantForAccessibility="no" />
        <View android:layout_width="5dp" android:layout_height="5dp"
            android:background="@drawable/bg_human_typing_dot" android:importantForAccessibility="no" />
    </LinearLayout>
</FrameLayout>
