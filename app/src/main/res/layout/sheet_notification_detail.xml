<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_notification_detail_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notifications_detail_sheet"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="30dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="0dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/button_notification_detail_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_login_icon_button"
            android:contentDescription="@string/notifications_close"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/conversations_close" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/container_notification_detail_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:background="@drawable/bg_email_identification_input"
        android:minHeight="125dp"
        android:orientation="vertical"
        android:paddingHorizontal="30dp"
        android:paddingVertical="20dp">

        <TextView
            android:id="@+id/text_notification_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_family"
            android:includeFontPadding="false"
            android:textColor="@color/astro_light_background"
            android:textSize="16sp"
            tools:text="Lembrete de treinamento de EPI" />

        <TextView
            android:id="@+id/text_notification_detail_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_family"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:textColor="@color/astro_input_hint"
            android:textSize="16sp"
            tools:text="Você tem 67 validações pendentes" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/container_notification_open_event"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:id="@+id/button_notification_open_event"
            style="@style/AstroPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/notifications_open_event">

            <TextView
                style="@style/AstroPrimaryActionLabel"
                android:importantForAccessibility="no"
                android:text="@string/notifications_open_event" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="18dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_notification_open_event" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
