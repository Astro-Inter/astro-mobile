<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:id="@+id/button_employee_event" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="75dp" android:baselineAligned="false"
        android:background="@drawable/bg_home_row_ripple" android:clickable="true" android:focusable="true"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="30dp" android:paddingVertical="20dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/text_employee_event_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:fontFamily="@font/montserrat_family"
                android:includeFontPadding="false" android:textColor="@color/astro_light_background"
                android:textSize="16sp" tools:text="Treinamento de EPI" />
            <TextView android:id="@+id/text_employee_event_due" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:fontFamily="@font/montserrat_family"
                android:includeFontPadding="false" android:textColor="@color/astro_input_hint"
                android:textSize="12sp" tools:text="Data limite: Amanhã" />
        </LinearLayout>
        <ImageView android:id="@+id/image_employee_event_status" android:layout_width="38dp"
            android:layout_height="38dp" android:padding="10dp" android:scaleType="fitCenter"
            android:contentDescription="@null" android:importantForAccessibility="no"
            tools:src="@drawable/home_warning" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="21dp"
        android:background="@drawable/bg_home_divider" android:importantForAccessibility="no" />
</LinearLayout>
