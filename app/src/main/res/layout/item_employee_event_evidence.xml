<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="30dp" android:layout_marginVertical="10dp"
    android:background="@drawable/bg_flow_choice_secondary_button">
    <TextView android:id="@+id/button_employee_event_file" style="@style/EmployeeEventDetailsButton"
        android:background="?attr/selectableItemBackground" />
    <ImageButton android:id="@+id/button_employee_event_remove_file"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="end|center_vertical" android:layout_marginEnd="2dp"
        android:background="@drawable/bg_home_icon_ripple" android:padding="15dp"
        android:src="@drawable/employee_event_close" android:scaleType="fitCenter"
        android:contentDescription="@string/employee_event_remove_evidence" />
</FrameLayout>
