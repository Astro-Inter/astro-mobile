<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="@dimen/employee_home_nav_height" android:background="@drawable/bg_home_bottom_nav"
    android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:id="@+id/button_conversations_nav_home" style="@style/ConversationsNavItem">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/employee_home_nav_icon_size" android:layout_height="@dimen/employee_home_nav_icon_size"
            android:duplicateParentState="true" android:src="@drawable/home_home"
            android:contentDescription="@null" app:tint="@color/nav_item_tint" />
        <TextView style="@style/ConversationsNavLabel" android:text="@string/employee_home_nav_home" />
    </LinearLayout>
    <LinearLayout android:id="@+id/button_conversations_nav_events" style="@style/ConversationsNavItem">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/employee_home_nav_icon_size" android:layout_height="@dimen/employee_home_nav_icon_size"
            android:duplicateParentState="true" android:src="@drawable/home_nav_calendar"
            android:contentDescription="@null" app:tint="@color/nav_item_tint" />
        <TextView style="@style/ConversationsNavLabel" android:text="@string/employee_home_nav_events" />
    </LinearLayout>
    <LinearLayout android:id="@+id/button_conversations_nav_chat" style="@style/ConversationsNavItem">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/employee_home_nav_icon_size" android:layout_height="@dimen/employee_home_nav_icon_size"
            android:duplicateParentState="true" android:src="@drawable/home_chat"
            android:contentDescription="@null" app:tint="@color/nav_item_tint" />
        <TextView style="@style/ConversationsNavLabel" android:text="@string/employee_home_nav_chat" />
    </LinearLayout>
    <LinearLayout android:id="@+id/button_conversations_nav_profile" style="@style/ConversationsNavItem">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/employee_home_nav_icon_size" android:layout_height="@dimen/employee_home_nav_icon_size"
            android:duplicateParentState="true" android:src="@drawable/home_user"
            android:contentDescription="@null" app:tint="@color/nav_item_tint" />
        <TextView style="@style/ConversationsNavLabel" android:text="@string/employee_home_nav_profile" />
    </LinearLayout>
</LinearLayout>
