<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/astro_dark_background"
    tools:context="com.example.astro_mobile.manager.forms.details.FormDetailsFragment">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintWidth_max="@dimen/employee_home_content_max_width"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/header_form_details" android:layout_width="0dp"
            android:layout_height="80dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:baselineAligned="false" android:paddingHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageButton android:id="@+id/button_form_details_back" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_back" android:paddingHorizontal="14dp"
                android:paddingVertical="16dp" android:src="@drawable/ic_login_back" android:scaleType="fitCenter" />
            <TextView style="@style/ManagerFormsText" android:layout_width="0dp" android:layout_weight="1"
                android:gravity="center" android:textSize="24sp" android:text="@string/manager_forms_title" />
            <ImageButton android:id="@+id/button_form_details_close" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_close" android:padding="14dp"
                android:src="@drawable/conversations_close" android:scaleType="fitCenter" />
        </LinearLayout>

        <ScrollView android:id="@+id/scroll_form_details" android:layout_width="0dp"
            android:layout_height="0dp" android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/header_form_details" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="30dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="30dp">
                    <TextView android:id="@+id/text_form_details_title" style="@style/ManagerFormsText"
                        android:textSize="24sp" tools:text="@string/form_details_title_mock" />
                    <TextView style="@style/ManagerFormsText" android:layout_marginTop="5dp"
                        android:textColor="@color/astro_input_hint" android:text="@string/form_details_subtitle" />
                </LinearLayout>
                <View style="@style/ManagerEventDetailsDivider" />
                <LinearLayout style="@style/ManagerEventDetailsRow">
                    <androidx.appcompat.widget.AppCompatImageView style="@style/ManagerEventDetailsIcon"
                        android:src="@drawable/home_calendar" />
                    <TextView style="@style/ManagerEventDetailsLabel" android:text="@string/employee_event_deadline_label" />
                    <TextView android:id="@+id/text_form_details_deadline" style="@style/ManagerEventDetailsValue"
                        tools:text="@string/form_details_deadline_mock" />
                </LinearLayout>
                <View style="@style/ManagerEventDetailsDivider" />
                <LinearLayout style="@style/ManagerEventDetailsRow">
                    <androidx.appcompat.widget.AppCompatImageView style="@style/ManagerEventDetailsIcon"
                        android:src="@drawable/employee_event_user" />
                    <TextView style="@style/ManagerEventDetailsLabel" android:text="@string/employee_event_sender_label" />
                    <TextView style="@style/ManagerEventDetailsValue" android:text="@string/form_details_sender_mock" />
                </LinearLayout>
                <View style="@style/ManagerEventDetailsDivider" />
                <LinearLayout style="@style/ManagerEventDetailsRow">
                    <androidx.appcompat.widget.AppCompatImageView style="@style/ManagerEventDetailsIcon"
                        android:layout_width="20dp" android:src="@drawable/home_building" />
                    <TextView style="@style/ManagerEventDetailsLabel" android:text="@string/form_details_unit_label" />
                    <TextView style="@style/ManagerEventDetailsValue" android:text="@string/form_details_unit_mock" />
                </LinearLayout>
                <View style="@style/ManagerEventDetailsDivider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30dp" android:layout_marginVertical="10dp"
                    android:orientation="vertical" android:paddingHorizontal="30dp" android:paddingVertical="20dp"
                    android:background="@drawable/bg_profile_panel">
                    <TextView style="@style/ManagerFormsText" android:text="@string/form_details_location_notice" />
                    <TextView android:id="@+id/text_form_details_location_explanation"
                        style="@style/ManagerFormsText" android:layout_marginTop="5dp"
                        android:textColor="@color/astro_input_hint" android:text="@string/form_details_location_explanation" />
                </LinearLayout>
                <LinearLayout android:id="@+id/container_form_details_location_message"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="120dp"
                    android:layout_marginHorizontal="30dp" android:layout_marginVertical="10dp"
                    android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical"
                    android:paddingHorizontal="30dp" android:paddingVertical="20dp"
                    android:background="@drawable/bg_home_positive_message">
                    <ImageView android:id="@+id/image_form_details_location_status" android:layout_width="18dp"
                        android:layout_height="18dp" android:layout_marginEnd="15dp" android:scaleType="fitCenter"
                        android:contentDescription="@null" android:importantForAccessibility="no"
                        android:src="@drawable/form_location_check" />
                    <TextView android:id="@+id/text_form_details_location_status" style="@style/ManagerFormsText"
                        android:layout_width="0dp" android:layout_weight="1" android:text="@string/form_details_inside_unit" />
                </LinearLayout>
                <View style="@style/ManagerEventDetailsDivider" />
                <LinearLayout android:id="@+id/container_form_details_consent" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginHorizontal="30dp"
                    android:orientation="vertical">
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/checkbox_form_location"
                        style="@style/Widget.Material3.CompoundButton.CheckBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="51dp"
                        android:saveEnabled="false"
                        android:gravity="center_vertical" app:useMaterialThemeColors="false"
                        app:buttonTint="@color/astro_primary_purple" app:buttonIconTint="@color/astro_light_background"
                        android:background="@drawable/bg_home_row_ripple" android:paddingVertical="10dp"
                        android:fontFamily="@font/montserrat_family" android:textColor="@color/astro_light_background"
                        android:includeFontPadding="false" android:textSize="16sp"
                        android:text="@string/form_details_consent" />
                    <TextView android:id="@+id/text_form_location_permission_error" style="@style/ManagerFormsCaption"
                        android:layout_marginTop="4dp" android:textColor="@color/astro_error"
                        android:text="@string/form_details_permission_error" android:visibility="gone" />
                    <TextView android:id="@+id/button_form_location_settings" style="@style/ManagerFormsText"
                        android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical"
                        android:paddingVertical="10dp" android:textSize="14sp" android:textColor="@color/astro_light_background"
                        android:background="@drawable/bg_home_row_ripple" android:clickable="true" android:focusable="true"
                        android:text="@string/form_details_open_settings" android:visibility="gone" />
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30dp" android:layout_marginVertical="10dp">
                    <TextView android:id="@+id/button_form_details_answer" style="@style/EmployeeEventDetailsButton"
                        android:enabled="false" android:background="@drawable/bg_form_details_button"
                        android:textColor="@color/form_details_button_text" android:text="@string/form_details_answer" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical" android:layout_marginEnd="15dp"
                        android:src="@drawable/ic_arrow_right" android:scaleType="fitCenter"
                        android:contentDescription="@null" android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>
        </ScrollView>
        <include android:id="@+id/skeleton_form_details" layout="@layout/view_form_details_skeleton"
            android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/header_form_details" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
