<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_events_sheet" android:orientation="vertical" android:paddingBottom="30dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="80dp">
        <View android:layout_width="120dp" android:layout_height="10dp" android:layout_gravity="center"
            android:background="@drawable/bg_home_skeleton_block" />
        <ImageButton android:id="@+id/button_employee_events_sheet_close" android:layout_width="48dp"
            android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="16dp"
            android:background="@drawable/bg_login_icon_button" android:src="@drawable/conversations_close"
            android:padding="14dp" android:contentDescription="@string/conversations_close" />
    </FrameLayout>
    <TextView android:id="@+id/text_employee_events_sheet_date" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="30dp" android:fontFamily="@font/montserrat_family"
        android:textColor="@color/astro_light_background" android:textSize="24sp" />
    <TextView android:id="@+id/text_employee_events_sheet_count" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="30dp" android:paddingTop="5dp"
        android:paddingBottom="10dp" android:fontFamily="@font/montserrat_family"
        android:textColor="@color/astro_input_hint" android:textSize="16sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list_employee_events_sheet"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
