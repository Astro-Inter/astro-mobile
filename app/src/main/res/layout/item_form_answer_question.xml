<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/text_form_question_label" style="@style/FormAnswerQuestion" />
    <EditText android:id="@+id/input_form_question_text" style="@style/FormAnswerInput"
        android:layout_marginHorizontal="30dp" android:layout_marginBottom="10dp"
        android:hint="@string/form_answer_input_hint" android:inputType="textCapSentences|textMultiLine"
        android:gravity="top|start" android:importantForAutofill="no" android:visibility="gone" />
    <RadioGroup android:id="@+id/group_form_question_options" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginHorizontal="30dp"
        android:orientation="vertical" android:visibility="gone" />
    <LinearLayout android:id="@+id/list_form_question_options" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginHorizontal="30dp"
        android:orientation="vertical" android:visibility="gone" />
    <EditText android:id="@+id/input_form_question_other" style="@style/FormAnswerInput"
        android:layout_marginHorizontal="30dp" android:layout_marginBottom="10dp"
        android:hint="@string/form_answer_other_hint" android:inputType="textCapSentences|textMultiLine"
        android:importantForAutofill="no" android:visibility="gone" />
    <FrameLayout android:id="@+id/container_form_question_date" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="10dp" android:visibility="gone">
        <TextView android:id="@+id/button_form_question_date" style="@style/FormAnswerInput"
            android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="52dp" android:hint="@string/form_answer_date_hint"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:layout_gravity="end|center_vertical" android:layout_marginEnd="16dp"
            android:src="@drawable/home_calendar" android:contentDescription="@null"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/text_form_question_notice" style="@style/ManagerFormsCaption"
        android:layout_marginHorizontal="30dp" android:layout_marginBottom="10dp" android:visibility="gone" />
    <View style="@style/ManagerEventDetailsDivider" />
</LinearLayout>
