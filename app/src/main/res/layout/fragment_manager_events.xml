<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/astro_dark_background"
    tools:context="com.example.astro_mobile.manager.events.ManagerEventsFragment">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintWidth_max="@dimen/employee_home_content_max_width"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:id="@+id/header_manager_events" android:layout_width="0dp"
            android:layout_height="80dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:baselineAligned="false" android:paddingHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageButton android:id="@+id/button_manager_events_back" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_back" android:paddingHorizontal="14dp"
                android:paddingVertical="16dp" android:src="@drawable/ic_login_back" android:scaleType="fitCenter" />
            <TextView style="@style/ManagerEventsText" android:layout_width="0dp" android:layout_weight="1"
                android:gravity="center" android:textSize="24sp" android:text="@string/manager_events_title" />
            <ImageButton android:id="@+id/button_manager_events_close" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_close" android:padding="14dp"
                android:src="@drawable/conversations_close" android:scaleType="fitCenter" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/container_manager_events_content"
            android:layout_width="0dp" android:layout_height="0dp" android:focusableInTouchMode="true"
            app:layout_constraintTop_toBottomOf="@id/header_manager_events" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:id="@+id/heading_manager_events" android:layout_width="0dp"
                android:layout_height="wrap_content" android:orientation="vertical" android:padding="30dp"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <TextView style="@style/ManagerEventsText" android:textSize="24sp" android:text="@string/manager_events_heading" />
                <TextView style="@style/ManagerEventsText" android:layout_marginTop="5dp"
                    android:textColor="@color/astro_input_hint" android:text="@string/manager_events_description" />
            </LinearLayout>
            <FrameLayout android:id="@+id/container_manager_events_search" android:layout_width="0dp"
                android:layout_height="wrap_content" android:paddingHorizontal="30dp" android:paddingVertical="10dp"
                app:layout_constraintTop_toBottomOf="@id/heading_manager_events" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                    <EditText android:id="@+id/input_manager_events_search" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="60dp"
                        android:background="@drawable/bg_email_identification_input"
                        android:hint="@string/employee_events_search" android:inputType="text" android:imeOptions="actionSearch"
                        android:singleLine="true" android:importantForAutofill="no" android:fontFamily="@font/montserrat_family"
                        android:paddingStart="16dp" android:paddingEnd="54dp" android:paddingVertical="12dp"
                        android:includeFontPadding="false" android:textColor="@color/astro_light_background"
                        android:textColorHint="@color/astro_input_hint" android:textSize="16sp" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_gravity="end|center_vertical" android:layout_marginEnd="16dp"
                        android:src="@drawable/manager_events_search" android:contentDescription="@null"
                        android:importantForAccessibility="no" android:scaleType="fitCenter" />
            </FrameLayout>
            <FrameLayout android:id="@+id/container_manager_events_dropdown" android:layout_width="0dp"
                android:layout_height="wrap_content" android:paddingHorizontal="30dp" android:paddingVertical="10dp"
                app:layout_constraintTop_toBottomOf="@id/container_manager_events_search"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                    <TextView android:id="@+id/button_manager_events_filter" style="@style/ManagerEventsText"
                        android:minHeight="60dp" android:background="@drawable/bg_conversations_filter"
                        android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                        android:paddingStart="15dp" android:paddingEnd="55dp" android:paddingVertical="10dp"
                        android:text="@string/manager_events_filter" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical" android:layout_marginEnd="15dp"
                        android:src="@drawable/manager_events_chevron_down"
                        android:scaleType="fitCenter" android:contentDescription="@null" android:importantForAccessibility="no" />
            </FrameLayout>
            <LinearLayout android:id="@+id/container_manager_events_filters" android:layout_width="0dp"
                android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false"
                android:paddingHorizontal="30dp" android:paddingVertical="10dp" android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/container_manager_events_search"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <TextView android:id="@+id/filter_manager_events_all" style="@style/ConversationsFilter"
                    android:text="@string/employee_events_all" android:textSize="12sp" tools:background="@color/astro_primary_purple" />
                <TextView android:id="@+id/filter_manager_events_progress" style="@style/ConversationsFilter"
                    android:layout_marginStart="10dp" android:text="@string/manager_events_in_progress" android:textSize="12sp" />
                <TextView android:id="@+id/filter_manager_events_finished" style="@style/ConversationsFilter"
                    android:layout_marginStart="10dp" android:text="@string/manager_events_finished" android:textSize="12sp" />
            </LinearLayout>
            <androidx.constraintlayout.widget.Barrier android:id="@+id/barrier_manager_events_filters"
                android:layout_width="wrap_content" android:layout_height="wrap_content" app:barrierDirection="bottom"
                app:barrierAllowsGoneWidgets="false"
                app:constraint_referenced_ids="container_manager_events_dropdown,container_manager_events_filters" />
            <View android:id="@+id/divider_manager_events_top" android:layout_width="0dp" android:layout_height="21dp"
                android:background="@drawable/bg_home_divider" android:importantForAccessibility="no"
                app:layout_constraintTop_toBottomOf="@id/barrier_manager_events_filters"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/list_manager_events"
                android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingBottom="30dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/divider_manager_events_top" app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_manager_event" tools:itemCount="4" />
            <LinearLayout android:id="@+id/container_manager_events_empty" android:layout_width="0dp"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/divider_manager_events_top"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <TextView style="@style/ManagerEventsText" android:minHeight="80dp" android:gravity="center"
                    android:paddingHorizontal="30dp" android:paddingVertical="10dp" android:text="@string/manager_events_empty" />
                <View android:layout_width="match_parent" android:layout_height="21dp"
                    android:background="@drawable/bg_home_divider" android:importantForAccessibility="no" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!-- Invisível na prévia XML; aparece somente durante a espera mock de 1s. -->
        <include android:id="@+id/skeleton_manager_events" layout="@layout/view_manager_events_skeleton"
            android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/header_manager_events" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
