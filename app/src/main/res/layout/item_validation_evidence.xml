<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:minHeight="60dp" android:layout_marginHorizontal="30dp"
    android:layout_marginTop="14dp" android:layout_marginBottom="10dp"
    android:background="@drawable/bg_flow_choice_secondary_button" android:clickable="true" android:focusable="true">
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="start|center_vertical"
        android:layout_marginStart="15dp" android:src="@drawable/event_evidence_open" android:scaleType="fitCenter"
        android:contentDescription="@null" android:importantForAccessibility="no" />
    <TextView android:id="@+id/text_validation_evidence_name" style="@style/EmployeeEventDetailsButton"
        android:background="@null" android:clickable="false" android:focusable="false" />
</FrameLayout>
