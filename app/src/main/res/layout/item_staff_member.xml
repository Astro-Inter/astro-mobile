<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:id="@+id/button_staff_member" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="84dp" android:baselineAligned="false"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="30dp" android:paddingVertical="20dp"
        android:background="@drawable/bg_home_row_ripple" android:clickable="true" android:focusable="true">
        <ImageView android:id="@+id/image_staff_avatar" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginEnd="20dp" android:src="@drawable/participant_avatar_1" android:scaleType="fitCenter"
            android:contentDescription="@null" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="137"
            android:orientation="vertical" android:layout_marginEnd="20dp">
            <TextView android:id="@+id/text_staff_name" style="@style/ManagerEventsText" tools:text="Kevin Parker" />
            <TextView android:id="@+id/text_staff_role" style="@style/ManagerEventsCaption" tools:text="Eletricista" />
        </LinearLayout>
        <TextView android:id="@+id/text_staff_pending" style="@style/ManagerEventsCaption"
            android:layout_width="0dp" android:layout_weight="113" android:gravity="end" tools:text="10 Pendências" />
        <!-- O componente do Figma reserva este espaço à direita, sem ícone. -->
        <Space android:layout_width="38dp" android:layout_height="38dp" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="21dp" android:background="@drawable/bg_home_divider"
        android:importantForAccessibility="no" />
</LinearLayout>
