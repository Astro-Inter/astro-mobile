<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/astro_dark_background"
    tools:showIn="@layout/activity_main">

    <LinearLayout
        android:id="@+id/container_password_reset_nav"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/button_password_reset_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="15dp"
            android:background="@drawable/bg_login_icon_button"
            android:contentDescription="@string/password_reset_back_description"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_login_back" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/container_password_reset_nav"
        app:layout_constraintWidth_max="430dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="10dp"
            android:paddingEnd="30dp"
            android:paddingBottom="160dp">

            <TextView
                android:id="@+id/text_password_reset_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_family"
                android:includeFontPadding="false"
                android:text="@string/password_reset_title"
                android:textColor="@color/astro_light_text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/text_password_reset_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/montserrat_family"
                android:includeFontPadding="false"
                android:text="@string/password_reset_description"
                android:textColor="@color/astro_input_hint"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/text_password_reset_email_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/montserrat_family"
                android:includeFontPadding="false"
                android:text="@string/email_identification_label"
                android:textColor="@color/astro_light_background"
                android:textSize="16sp" />

            <FrameLayout
                android:id="@+id/container_password_reset_email"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_email_identification_input">

                <EditText
                    android:id="@+id/input_password_reset_email"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="emailAddress"
                    android:background="@null"
                    android:fontFamily="@font/montserrat_family"
                    android:gravity="center_vertical"
                    android:hint="@string/email_identification_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/astro_light_background"
                    android:textColorHint="@color/astro_input_hint"
                    android:textSize="16sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_password_reset_email_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/montserrat_family"
                android:includeFontPadding="false"
                android:textColor="@color/astro_error"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Este não é um e-mail válido." />

            <FrameLayout
                android:id="@+id/button_password_reset_send"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_login_password_button"
                android:clickable="true"
                android:contentDescription="@string/password_reset_send"
                android:focusable="true">

                <TextView
                    android:id="@+id/text_password_reset_send"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/montserrat_family"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/password_reset_send"
                    android:textColor="@color/astro_light_background"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/progress_password_reset_send"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/astro_light_background"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
