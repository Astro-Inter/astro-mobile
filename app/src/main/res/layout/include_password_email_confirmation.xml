<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:overScrollMode="ifContentScrolls">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        android:paddingHorizontal="30dp" android:paddingVertical="24dp">
        <FrameLayout android:layout_width="100dp" android:layout_height="100dp"
            android:background="@drawable/bg_password_email_confirmation">
            <ImageView android:layout_width="20dp" android:layout_height="16dp"
                android:layout_gravity="center" android:src="@drawable/ic_email_closed"
                android:contentDescription="@null" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:id="@+id/text_password_email_confirmation_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:fontFamily="@font/montserrat_family"
            android:textFontWeight="600" android:textSize="24sp" android:lineHeight="32sp"
            android:includeFontPadding="false" android:gravity="center"
            android:text="@string/password_reset_confirmation_title"
            android:textColor="@color/astro_light_background" />
        <TextView android:id="@+id/text_password_email_confirmation_body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp" android:layout_marginTop="18dp"
            android:fontFamily="@font/montserrat_family" android:textSize="16sp" android:lineHeight="24sp"
            android:includeFontPadding="false" android:gravity="center"
            android:text="@string/password_reset_confirmation_body"
            android:textColor="@color/astro_input_hint" />
        <TextView android:id="@+id/button_password_email_confirmation_return"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="60dp" android:padding="15dp" android:layout_marginTop="28dp"
            android:background="@drawable/bg_login_password_button"
            android:clickable="true" android:focusable="true"
            android:fontFamily="@font/montserrat_family" android:textSize="16sp"
            android:gravity="center" android:includeFontPadding="false"
            android:textColor="@color/astro_light_background"
            tools:text="Voltar à identificação de e-mail" />
    </LinearLayout>
</ScrollView>
