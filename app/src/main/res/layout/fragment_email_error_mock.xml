<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/astro_dark_background"
    tools:showIn="@layout/activity_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingEnd="30dp">

            <TextView
                android:id="@+id/text_email_error_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center"
                android:textColor="@color/astro_light_background"
                android:textSize="24sp"
                tools:text="Algo deu errado" />

            <TextView
                android:id="@+id/text_email_error_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center"
                android:textColor="@color/astro_input_hint"
                android:textSize="16sp"
                tools:text="Não foi possível concluir esta ação. Tente novamente em instantes." />

            <FrameLayout
                android:id="@+id/button_email_error_retry"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_login_password_button"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/text_email_error_retry"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/montserrat_family"
                    android:gravity="center"
                    android:text="@string/email_error_retry"
                    android:textColor="@color/astro_light_background"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/progress_email_error_retry"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/astro_light_background"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/button_email_error_start"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_flow_choice_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center"
                android:text="@string/email_error_start"
                android:textColor="@color/astro_light_background"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
