<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/astro_dark_background"
    tools:context="com.example.astro_mobile.manager.home.ManagerHomeFragment">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_manager_home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_max="@dimen/employee_home_content_max_width"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:id="@+id/header_manager_home"
            android:layout_width="0dp"
            android:layout_height="@dimen/employee_home_header_height"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:paddingStart="30dp"
            android:paddingEnd="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageView
                android:layout_width="@dimen/employee_home_logo_width"
                android:layout_height="@dimen/employee_home_logo_height"
                android:src="@drawable/home_logo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/astro_logo_content_description" />
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <FrameLayout
                android:id="@+id/button_manager_home_notifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_home_icon_ripple"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/employee_home_notification_button">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/home_notification"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
        <ScrollView
            android:id="@+id/scroll_manager_home"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            app:layout_constraintTop_toBottomOf="@id/header_manager_home"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="90dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="30dp"
                    android:paddingVertical="20dp">
                    <TextView
                        android:id="@+id/text_manager_home_greeting"
                        style="@style/ManagerHomeText.Heading"
                        android:text="@string/manager_home_greeting" />
                    <TextView
                        style="@style/ManagerHomeText.Subtitle"
                        android:text="@string/manager_home_summary" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="30dp"
                    android:paddingVertical="20dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        style="@style/ManagerHomeIcon"
                        android:src="@drawable/home_building"
                        android:layout_marginEnd="10dp" />
                    <TextView
                        style="@style/ManagerHomeText"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/manager_home_workspace_label" />
                    <TextView
                        android:id="@+id/text_manager_home_workspace"
                        style="@style/ManagerHomeText"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/manager_home_workspace_name" />
                </LinearLayout>
                <View style="@style/ManagerHomeDivider" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="30dp"
                    android:paddingVertical="20dp">
                    <TextView
                        style="@style/ManagerHomeText.Heading"
                        android:text="@string/manager_home_actions_title" />
                    <TextView
                        style="@style/ManagerHomeText.Subtitle"
                        android:text="@string/manager_home_actions_subtitle" />
                </LinearLayout>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    android:paddingHorizontal="30dp"
                    android:paddingVertical="20dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:id="@+id/button_manager_home_validate"
                            android:layout_width="163dp"
                            android:layout_height="175dp"
                            android:layout_marginEnd="20dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_manager_home_action"
                            android:padding="20dp"
                            android:clickable="true"
                            android:focusable="true">
                            <androidx.appcompat.widget.AppCompatImageView
                                style="@style/ManagerHomeIcon"
                                android:src="@drawable/home_eye" />
                            <Space
                                android:layout_width="1dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />
                            <TextView
                                style="@style/ManagerHomeText"
                                android:text="@string/manager_home_validate" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/button_manager_home_employees"
                            android:layout_width="163dp"
                            android:layout_height="175dp"
                            android:layout_marginEnd="20dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_manager_home_action"
                            android:padding="20dp"
                            android:clickable="true"
                            android:focusable="true">
                            <androidx.appcompat.widget.AppCompatImageView
                                style="@style/ManagerHomeIcon"
                                android:src="@drawable/profile_user_group" />
                            <Space
                                android:layout_width="1dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />
                            <TextView
                                style="@style/ManagerHomeText"
                                android:text="@string/manager_home_employees" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/button_manager_home_forms_action"
                            android:layout_width="163dp"
                            android:layout_height="175dp"
                            android:layout_marginEnd="20dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_manager_home_action"
                            android:padding="20dp"
                            android:clickable="true"
                            android:focusable="true">
                            <androidx.appcompat.widget.AppCompatImageView
                                style="@style/ManagerHomeIcon"
                                android:src="@drawable/manager_notes" />
                            <Space
                                android:layout_width="1dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />
                            <TextView
                                style="@style/ManagerHomeText"
                                android:text="@string/manager_home_forms_action" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/button_manager_home_conversations"
                            android:layout_width="163dp"
                            android:layout_height="175dp"
                            android:layout_marginEnd="0dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_manager_home_action"
                            android:padding="20dp"
                            android:clickable="true"
                            android:focusable="true">
                            <androidx.appcompat.widget.AppCompatImageView
                                style="@style/ManagerHomeIcon"
                                android:src="@drawable/home_chat" />
                            <Space
                                android:layout_width="1dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />
                            <TextView
                                style="@style/ManagerHomeText"
                                android:text="@string/manager_home_conversations" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
                <View style="@style/ManagerHomeDivider" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/button_manager_home_validations"
                    style="@style/ManagerHomeSection">
                    <TextView
                        android:id="@+id/text_manager_validations_heading"
                        style="@style/ManagerHomeText"
                        android:layout_width="wrap_content"
                        android:text="@string/manager_home_validations"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/image_manager_validations_chevron"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <ImageView
                        android:id="@+id/image_manager_validations_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/home_chevron"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        app:layout_constraintStart_toEndOf="@id/text_manager_validations_heading"
                        app:layout_constraintEnd_toStartOf="@id/image_manager_validations_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/image_manager_validations_icon"
                        style="@style/ManagerHomeIcon"
                        android:src="@drawable/home_eye"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <include
                    android:id="@+id/row_manager_validations_1"
                    layout="@layout/item_manager_home_feed_row" />
                <include
                    android:id="@+id/row_manager_validations_2"
                    layout="@layout/item_manager_home_feed_row" />
                <include
                    android:id="@+id/row_manager_validations_3"
                    layout="@layout/item_manager_home_feed_row" />
                <TextView
                    android:id="@+id/button_manager_home_validations_more"
                    style="@style/ManagerHomeMore" />
                <View style="@style/ManagerHomeDivider" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/button_manager_home_forms"
                    style="@style/ManagerHomeSection">
                    <TextView
                        android:id="@+id/text_manager_forms_heading"
                        style="@style/ManagerHomeText"
                        android:layout_width="wrap_content"
                        android:text="@string/manager_home_forms"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/image_manager_forms_chevron"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <ImageView
                        android:id="@+id/image_manager_forms_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/home_chevron"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        app:layout_constraintStart_toEndOf="@id/text_manager_forms_heading"
                        app:layout_constraintEnd_toStartOf="@id/image_manager_forms_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/image_manager_forms_icon"
                        style="@style/ManagerHomeIcon"
                        android:src="@drawable/manager_notes"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <include
                    android:id="@+id/row_manager_forms_1"
                    layout="@layout/item_manager_home_feed_row" />
                <include
                    android:id="@+id/row_manager_forms_2"
                    layout="@layout/item_manager_home_feed_row" />
                <include
                    android:id="@+id/row_manager_forms_3"
                    layout="@layout/item_manager_home_feed_row" />
                <TextView
                    android:id="@+id/button_manager_home_forms_more"
                    style="@style/ManagerHomeMore" />
                <View style="@style/ManagerHomeDivider" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="30dp"
                    android:paddingVertical="10dp">
                    <TextView
                        style="@style/ManagerHomeText.Heading"
                        android:text="@string/manager_home_indicators_title" />
                    <TextView
                        style="@style/ManagerHomeText.Subtitle"
                        android:text="@string/manager_home_indicators_subtitle" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:paddingHorizontal="30dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:minHeight="117dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_home_card_ripple"
                        android:padding="10dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false"
                            android:gravity="top">
                            <TextView
                                android:id="@+id/text_manager_home_validation_count"
                                style="@style/ManagerHomeText.Heading"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/manager_home_validation_count" />
                            <androidx.appcompat.widget.AppCompatImageView
                                style="@style/ManagerHomeIcon"
                                android:src="@drawable/home_eye" />
                        </LinearLayout>
                        <Space
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <TextView
                            style="@style/ManagerHomeText"
                            android:text="@string/manager_home_validations" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:minHeight="117dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_home_card_ripple"
                        android:padding="10dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false"
                            android:gravity="top">
                            <TextView
                                android:id="@+id/text_manager_home_event_count"
                                style="@style/ManagerHomeText.Heading"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/manager_home_event_count" />
                            <androidx.appcompat.widget.AppCompatImageView
                                style="@style/ManagerHomeIcon"
                                android:src="@drawable/home_calendar" />
                        </LinearLayout>
                        <Space
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <TextView
                            style="@style/ManagerHomeText"
                            android:text="@string/manager_home_events_indicator" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:minHeight="117dp"
                    android:layout_marginStart="30dp"
                    android:layout_marginEnd="30dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_home_card_ripple"
                    android:padding="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:gravity="top">
                        <TextView
                            android:id="@+id/text_manager_home_employee_count"
                            style="@style/ManagerHomeText.Heading"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/manager_home_employee_count" />
                        <androidx.appcompat.widget.AppCompatImageView
                            style="@style/ManagerHomeIcon"
                            android:src="@drawable/profile_user_group" />
                    </LinearLayout>
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <TextView
                        style="@style/ManagerHomeText"
                        android:text="@string/manager_home_employees_indicator" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <include
            android:id="@+id/container_manager_home_skeleton"
            layout="@layout/view_manager_home_skeleton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            tools:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/header_manager_home"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <FrameLayout
            android:id="@+id/button_manager_home_ai"
            android:layout_width="0dp"
            android:layout_height="@dimen/employee_home_ai_size"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="@dimen/employee_home_ai_bottom_margin"
            android:background="@drawable/bg_home_ai_bubble"
            android:clickable="true"
            android:contentDescription="@string/employee_home_ai_button"
            android:elevation="6dp"
            android:focusable="true"
            android:clipChildren="true"
            android:clipToPadding="true"
            app:layout_constraintWidth_max="@dimen/employee_home_ai_bubble_max_width"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/container_manager_home"
            app:layout_constraintStart_toStartOf="@id/container_manager_home">

            <TextView
                android:id="@+id/text_manager_home_ai_bubble"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="28dp"
                android:paddingEnd="68dp"
                android:text="@string/employee_home_ai_prompt"
                android:textColor="@color/astro_light_text"
                android:textSize="@dimen/employee_home_ai_bubble_text_size" />

            <FrameLayout
                android:layout_width="@dimen/employee_home_ai_size"
                android:layout_height="@dimen/employee_home_ai_size"
                android:layout_gravity="end|center_vertical"
                android:importantForAccessibility="no">

                <ImageView
                    android:layout_width="@dimen/employee_home_ai_mascot_width"
                    android:layout_height="@dimen/employee_home_ai_mascot_height"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleX="-1"
                    android:scaleType="fitCenter"
                    android:src="@drawable/home_mascot" />
            </FrameLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
