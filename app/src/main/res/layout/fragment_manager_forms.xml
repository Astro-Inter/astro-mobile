<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    tools:context="com.example.astro_mobile.manager.forms.ManagerFormsFragment">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintWidth_max="@dimen/employee_home_content_max_width"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:id="@+id/header_manager_forms" android:layout_width="0dp"
            android:layout_height="80dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:baselineAligned="false" android:paddingHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageButton android:id="@+id/button_manager_forms_back" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_back" android:paddingHorizontal="14dp"
                android:paddingVertical="16dp" android:src="@drawable/ic_login_back" android:scaleType="fitCenter" />
            <TextView style="@style/ManagerFormsText" android:layout_width="0dp" android:layout_weight="1"
                android:gravity="center" android:textSize="24sp" android:text="@string/manager_forms_title" />
            <ImageButton android:id="@+id/button_manager_forms_close" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_close" android:padding="14dp"
                android:src="@drawable/conversations_close" android:scaleType="fitCenter" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/container_manager_forms_content"
            android:layout_width="0dp" android:layout_height="0dp" android:focusableInTouchMode="true"
            app:layout_constraintTop_toBottomOf="@id/header_manager_forms" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <FrameLayout android:id="@+id/container_manager_forms_search" android:layout_width="0dp"
                android:layout_height="wrap_content" android:paddingHorizontal="30dp" android:paddingTop="10dp"
                android:paddingBottom="8dp" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <EditText android:id="@+id/input_manager_forms_search" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="56dp"
                    android:background="@drawable/bg_email_identification_input"
                    android:hint="@string/manager_forms_search_hint" android:inputType="text"
                    android:imeOptions="actionSearch" android:singleLine="true" android:importantForAutofill="no"
                    android:fontFamily="@font/montserrat_family" android:paddingStart="16dp" android:paddingEnd="52dp"
                    android:paddingVertical="12dp" android:includeFontPadding="false"
                    android:textColor="@color/astro_light_background" android:textColorHint="@color/astro_input_hint"
                    android:textSize="14sp" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical" android:layout_marginEnd="16dp"
                    android:src="@drawable/manager_events_search" android:contentDescription="@null"
                    android:importantForAccessibility="no" android:scaleType="fitCenter" />
            </FrameLayout>

            <FrameLayout android:id="@+id/container_manager_forms_nr_filter" android:layout_width="0dp"
                android:layout_height="wrap_content" android:paddingHorizontal="30dp" android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/container_manager_forms_search"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <TextView android:id="@+id/button_manager_forms_nr_filter" style="@style/ManagerFormsText"
                    android:minHeight="52dp" android:background="@drawable/bg_conversations_filter"
                    android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                    android:paddingStart="15dp" android:paddingEnd="52dp" android:paddingVertical="10dp"
                    android:text="@string/manager_forms_filter_nr" android:textSize="14sp" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical" android:layout_marginEnd="15dp"
                    android:src="@drawable/manager_events_chevron_down" android:scaleType="fitCenter"
                    android:contentDescription="@null" android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout android:id="@+id/container_manager_forms_filters" android:layout_width="0dp"
                android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false"
                android:paddingHorizontal="30dp" android:paddingVertical="8dp"
                app:layout_constraintTop_toBottomOf="@id/container_manager_forms_nr_filter"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <TextView android:id="@+id/filter_manager_forms_all" style="@style/ConversationsFilter"
                    android:text="@string/employee_events_all" android:textSize="12sp"
                    tools:background="@color/astro_primary_purple" />
                <TextView android:id="@+id/filter_manager_forms_progress" style="@style/ConversationsFilter"
                    android:layout_marginStart="8dp" android:text="@string/manager_forms_in_progress" android:textSize="12sp" />
                <TextView android:id="@+id/filter_manager_forms_finished" style="@style/ConversationsFilter"
                    android:layout_marginStart="8dp" android:text="@string/manager_forms_finished_filter" android:textSize="12sp" />
            </LinearLayout>

            <View android:id="@+id/divider_manager_forms_top" android:layout_width="0dp" android:layout_height="21dp"
                android:background="@drawable/bg_home_divider" android:importantForAccessibility="no"
                app:layout_constraintTop_toBottomOf="@id/container_manager_forms_filters"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/list_manager_forms"
                android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false"
                android:paddingBottom="30dp" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/divider_manager_forms_top"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_manager_form" tools:itemCount="4" />
            <TextView android:id="@+id/text_manager_forms_empty" style="@style/ManagerFormsText"
                android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="80dp"
                android:gravity="center" android:paddingHorizontal="30dp" android:paddingVertical="16dp"
                android:text="@string/manager_forms_empty" android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/divider_manager_forms_top"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Skeleton de demonstração; fica oculto no preview e dura 1s em execução. -->
        <include android:id="@+id/skeleton_manager_forms" layout="@layout/view_manager_forms_skeleton"
            android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/header_manager_forms" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
