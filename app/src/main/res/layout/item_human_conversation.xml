<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout android:id="@+id/button_human_conversation"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="84dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:baselineAligned="false"
        android:paddingHorizontal="30dp" android:paddingVertical="20dp"
        android:background="@drawable/bg_home_row_ripple"
        android:clickable="true" android:focusable="true">
        <ImageView android:id="@+id/image_human_conversation_avatar"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginEnd="20dp" android:scaleType="fitCenter"
            android:contentDescription="@null" android:src="@drawable/human_chat_manager_avatar" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/text_human_conversation_name"
                style="@style/ManagerEventsText"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/text_human_conversation_preview"
                style="@style/ManagerEventsCaption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/text_human_conversation_count"
            style="@style/ManagerEventsText"
            android:layout_width="29dp" android:layout_height="29dp"
            android:layout_marginStart="10dp" android:gravity="center"
            android:background="@drawable/bg_human_chat_badge"
            android:textSize="17.5sp" android:text="@string/human_conversation_example_count" />
    </LinearLayout>
    <View android:id="@+id/divider_human_conversation"
        android:layout_width="match_parent" android:layout_height="21dp"
        android:importantForAccessibility="no" android:background="@drawable/bg_home_divider" />
</LinearLayout>
