<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/astro_dark_background"
    tools:context="com.example.astro_mobile.manager.events.validation.EventValidationFragment">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintWidth_max="@dimen/employee_home_content_max_width"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/header_event_validation" android:layout_width="0dp"
            android:layout_height="80dp" android:layout_marginTop="4dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:baselineAligned="false" android:paddingHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageButton android:id="@+id/button_validation_back" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_back" android:paddingHorizontal="14dp"
                android:paddingVertical="16dp" android:src="@drawable/ic_login_back" android:scaleType="fitCenter" />
            <TextView style="@style/ManagerEventsText" android:layout_width="0dp" android:layout_weight="1"
                android:gravity="center" android:textSize="24sp" android:text="@string/event_validation_title" />
            <ImageButton android:id="@+id/button_validation_close" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_close" android:padding="14dp"
                android:src="@drawable/conversations_close" android:scaleType="fitCenter" />
        </LinearLayout>

        <ScrollView android:id="@+id/container_validation_content" android:layout_width="0dp"
            android:layout_height="0dp" android:layout_marginTop="4dp"
            android:clipToPadding="false" android:paddingBottom="30dp"
            app:layout_constraintTop_toBottomOf="@id/header_event_validation"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="74dp" android:orientation="horizontal" android:gravity="center_vertical"
                    android:baselineAligned="false" android:paddingHorizontal="30dp">
                    <ImageView android:id="@+id/image_validation_participant" android:layout_width="56dp"
                        android:layout_height="56dp" android:src="@drawable/participant_avatar_1"
                        android:scaleType="fitCenter" android:contentDescription="@null" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:paddingHorizontal="30dp"
                        android:paddingVertical="10dp" android:orientation="vertical">
                        <TextView android:id="@+id/text_validation_participant" style="@style/ManagerEventsText"
                            android:textSize="24sp" android:textStyle="bold" android:text="@string/event_validation_participant_mock" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="5dp" android:orientation="horizontal"
                            android:baselineAligned="false" android:gravity="center_vertical">
                            <ImageView android:layout_width="20dp" android:layout_height="18dp"
                                android:layout_marginEnd="10dp" android:src="@drawable/profile_user_group"
                                app:tint="@color/astro_input_hint" android:scaleType="fitCenter"
                                android:contentDescription="@null" android:importantForAccessibility="no" />
                            <TextView style="@style/ManagerEventsText" android:layout_width="0dp" android:layout_weight="1"
                                android:textColor="@color/astro_input_hint" android:textStyle="bold"
                                android:text="@string/event_validation_job_mock" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <View style="@style/EventValidationDivider" />
                <LinearLayout android:id="@+id/button_validation_event" style="@style/EventValidationRow"
                    android:background="@drawable/bg_home_row_ripple" android:clickable="true" android:focusable="true">
                    <androidx.appcompat.widget.AppCompatImageView style="@style/ManagerEventDetailsIcon" android:src="@drawable/home_calendar"
                        android:contentDescription="@null" />
                    <TextView style="@style/ManagerEventDetailsLabel" android:text="@string/event_validation_event_label" />
                    <TextView android:id="@+id/text_validation_event" style="@style/ManagerEventDetailsValue"
                        android:text="@string/manager_event_title_mock" />
                </LinearLayout>
                <View style="@style/EventValidationDivider" />
                <LinearLayout style="@style/EventValidationRow">
                    <androidx.appcompat.widget.AppCompatImageView style="@style/ManagerEventDetailsIcon" android:layout_width="20dp"
                        android:layout_height="18.2dp" android:src="@drawable/profile_building" android:contentDescription="@null" />
                    <TextView style="@style/ManagerEventDetailsLabel" android:text="@string/profile_unit" />
                    <TextView style="@style/ManagerEventDetailsValue" android:text="@string/event_validation_unit_mock" />
                </LinearLayout>
                <View style="@style/EventValidationDivider" />
                <LinearLayout style="@style/EventValidationRow" android:paddingVertical="10dp">
                    <androidx.appcompat.widget.AppCompatImageView style="@style/ManagerEventDetailsIcon" android:layout_width="18.2dp"
                        android:layout_height="18.2dp" android:src="@drawable/event_completion_calendar" android:contentDescription="@null" />
                    <TextView style="@style/ManagerEventDetailsLabel" android:text="@string/event_validation_completion_label" />
                    <TextView style="@style/ManagerEventDetailsValue" android:text="@string/event_validation_completion_mock" />
                </LinearLayout>
                <View style="@style/EventValidationDivider" />
                <TextView style="@style/EventValidationHeading" android:text="@string/manager_event_information" />
                <LinearLayout style="@style/EventValidationRow" android:paddingVertical="10dp">
                    <androidx.appcompat.widget.AppCompatImageView style="@style/ManagerEventDetailsIcon" android:layout_width="20dp"
                        android:layout_height="18.2dp" android:src="@drawable/event_assignment_clock" android:contentDescription="@null" />
                    <TextView style="@style/ManagerEventDetailsLabel" android:text="@string/event_validation_deadline_label" />
                    <TextView style="@style/ManagerEventDetailsValue" android:text="@string/event_validation_deadline_mock" />
                </LinearLayout>
                <View style="@style/EventValidationDivider" />
                <LinearLayout style="@style/EventValidationRow" android:paddingVertical="10dp">
                    <androidx.appcompat.widget.AppCompatImageView style="@style/ManagerEventDetailsIcon" android:layout_width="18.2dp"
                        android:layout_height="18.2dp" android:src="@drawable/employee_event_link" android:contentDescription="@null" />
                    <TextView style="@style/ManagerEventDetailsLabel" android:text="@string/event_validation_evidence_required" />
                    <TextView style="@style/ManagerEventDetailsValue" android:text="@string/event_validation_evidence_yes" />
                </LinearLayout>
                <View style="@style/EventValidationDivider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:paddingHorizontal="30dp" android:paddingVertical="10dp"
                    android:orientation="vertical">
                    <TextView style="@style/ManagerEventsText" android:textSize="24sp"
                        android:text="@string/event_validation_evidence_title" />
                    <TextView style="@style/ManagerEventsText" android:layout_marginTop="5dp"
                        android:textColor="@color/astro_input_hint"
                        android:text="@string/event_validation_evidence_description" />
                </LinearLayout>
                <FrameLayout android:id="@+id/button_validation_evidence" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="60dp"
                    android:layout_marginHorizontal="30dp" android:layout_marginTop="14dp" android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_flow_choice_secondary_button" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_gravity="start|center_vertical" android:layout_marginStart="15dp"
                        android:src="@drawable/event_evidence_open" android:scaleType="fitCenter"
                        android:contentDescription="@null" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/text_validation_evidence" style="@style/EmployeeEventDetailsButton"
                        android:background="@null" android:clickable="false" android:focusable="false"
                        android:text="@string/employee_event_evidence_filename" />
                </FrameLayout>
                <View style="@style/EventValidationDivider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:paddingHorizontal="30dp" android:paddingVertical="10dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/button_validation_confirm" style="@style/EmployeeEventDetailsButton"
                        android:background="@drawable/bg_login_password_button" android:text="@string/event_validation_confirm" />
                    <TextView android:id="@+id/button_validation_reject" style="@style/EmployeeEventDetailsButton"
                        android:layout_marginTop="10dp" android:background="@drawable/bg_event_validation_reject"
                        android:text="@string/event_validation_reject" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <!-- O editor mostra a tela real; o skeleton aparece somente durante a espera mock. -->
        <include android:id="@+id/skeleton_event_validation" layout="@layout/view_event_validation_skeleton"
            android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/header_event_validation"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
