<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:id="@+id/button_manager_form" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="86dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:baselineAligned="false"
        android:background="@drawable/bg_home_row_ripple" android:clickable="true" android:focusable="true"
        android:paddingHorizontal="30dp" android:paddingVertical="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/text_manager_form_title" style="@style/ManagerFormsText"
                android:textSize="14sp" tools:text="Checklist de Inspeção de segurança" />
            <TextView android:id="@+id/text_manager_form_deadline" style="@style/ManagerFormsCaption"
                android:layout_marginTop="4dp" tools:text="Data limite: amanhã" />
            <TextView android:id="@+id/text_manager_form_nr" style="@style/ManagerFormsCaption"
                tools:text="NR - 5" />
        </LinearLayout>
        <TextView android:id="@+id/text_manager_form_status" style="@style/ManagerFormsCaption"
            android:layout_width="82dp" android:gravity="end" android:paddingStart="6dp" android:paddingEnd="0dp"
            android:maxLines="2" tools:text="Urgente" />
        <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
            <ImageView android:id="@+id/image_manager_form_status" android:layout_width="18dp"
                android:layout_height="18dp" android:layout_gravity="center" android:scaleType="fitCenter"
                android:contentDescription="@null" android:importantForAccessibility="no"
                tools:src="@drawable/ic_employee_event_warning" />
        </FrameLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="21dp"
        android:background="@drawable/bg_home_divider" android:importantForAccessibility="no" />
</LinearLayout>
