<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_dialog">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="306dp">
        <ImageButton android:id="@+id/button_validation_rejection_close" android:layout_width="48dp"
            android:layout_height="48dp" android:layout_marginTop="16dp" android:layout_marginEnd="16dp"
            android:background="@drawable/bg_login_icon_button" android:padding="14dp"
            android:src="@drawable/conversations_close" android:contentDescription="@string/conversations_close"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/text_validation_rejection_label" style="@style/ManagerEventsText"
            android:layout_width="0dp" android:layout_marginHorizontal="30dp" android:layout_marginTop="50dp"
            android:text="@string/event_validation_reason_label"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <EditText android:id="@+id/input_validation_rejection_reason" android:layout_width="0dp"
            android:layout_height="wrap_content" android:minHeight="80dp" android:layout_marginHorizontal="30dp"
            android:layout_marginTop="10dp" android:background="@drawable/bg_profile_panel"
            android:paddingHorizontal="30dp" android:paddingVertical="20dp" android:gravity="top|start"
            android:fontFamily="@font/montserrat_family" android:includeFontPadding="false" android:textSize="16sp"
            android:textColor="@color/astro_light_background" android:textColorHint="@color/astro_input_hint"
            android:inputType="textCapSentences|textMultiLine" android:minLines="2" android:importantForAutofill="no"
            android:hint="@string/event_validation_reason_hint"
            app:layout_constraintTop_toBottomOf="@id/text_validation_rejection_label"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/button_validation_rejection_submit" style="@style/EmployeeEventDetailsButton"
            android:layout_width="0dp" android:layout_marginHorizontal="30dp" android:layout_marginTop="35dp"
            android:layout_marginBottom="55dp" android:enabled="false"
            android:background="@drawable/bg_event_validation_submit" android:text="@string/event_validation_reject"
            app:layout_constraintTop_toBottomOf="@id/input_validation_rejection_reason"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
