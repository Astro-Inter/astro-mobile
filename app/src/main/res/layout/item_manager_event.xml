<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <LinearLayout android:id="@+id/button_manager_event" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="75dp" android:baselineAligned="false"
        android:background="@drawable/bg_home_row_ripple" android:clickable="true" android:focusable="true"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="30dp" android:paddingVertical="20dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="221" android:orientation="vertical">
            <TextView android:id="@+id/text_manager_event_title" style="@style/ManagerEventsText"
                tools:text="Treinamento de EPI" />
            <TextView android:id="@+id/text_manager_event_subtitle" style="@style/ManagerEventsCaption"
                tools:text="Validações pendentes: 4" />
        </LinearLayout>
        <TextView android:id="@+id/text_manager_event_status" style="@style/ManagerEventsCaption"
            android:layout_width="0dp" android:layout_weight="111" android:gravity="end"
            android:paddingStart="10dp" android:paddingEnd="0dp" tools:text="Validação pendente" />
        <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
            <ImageView android:id="@+id/image_manager_event_status"
                android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center"
                android:scaleType="fitCenter" android:contentDescription="@null"
                android:importantForAccessibility="no" tools:src="@drawable/home_new" />
        </FrameLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="21dp"
        android:background="@drawable/bg_home_divider" android:importantForAccessibility="no" />
</LinearLayout>
