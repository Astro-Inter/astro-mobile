<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="16dp" android:orientation="horizontal"
    android:gravity="top" android:baselineAligned="false">
    <ImageView android:id="@+id/image_chat_avatar"
        android:layout_width="28dp" android:layout_height="32dp" android:layout_marginEnd="8dp"
        android:layout_marginTop="18dp" android:src="@drawable/home_mascot"
        android:contentDescription="@null" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/container_chat_message"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:background="@drawable/bg_chat_assistant"
        android:padding="16dp">
        <TextView android:id="@+id/text_chat_sender"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_family" android:textSize="11sp"
            android:textStyle="bold" android:layout_marginBottom="6dp" />
        <TextView android:id="@+id/text_chat_message"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_family" android:textSize="15sp"
            android:lineSpacingExtra="4dp" android:textColor="@color/chat_text"
            android:textColorLink="@color/chat_user" android:textIsSelectable="true" />
    </LinearLayout>
</LinearLayout>
