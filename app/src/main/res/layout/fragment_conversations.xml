<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/astro_dark_background"
    tools:context="com.example.astro_mobile.chat.ConversationsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_max="@dimen/employee_home_content_max_width"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/container_conversations_header"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:baselineAligned="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/button_conversations_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_back"
                android:paddingHorizontal="14dp"
                android:paddingVertical="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_login_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/conversations_title"
                android:textColor="@color/astro_light_background"
                android:textSize="24sp" />

            <ImageButton
                android:id="@+id/button_conversations_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_close"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/conversations_close" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_conversations_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="30dp"
            app:layout_constraintTop_toBottomOf="@id/container_conversations_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_family"
                android:includeFontPadding="false"
                android:text="@string/conversations_heading"
                android:textColor="@color/astro_light_background"
                android:textSize="@dimen/employee_home_heading_text_size" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/montserrat_family"
                android:includeFontPadding="false"
                android:text="@string/conversations_subtitle"
                android:textColor="@color/astro_input_hint"
                android:textSize="@dimen/employee_home_body_text_size" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/container_conversations_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="30dp"
            android:paddingVertical="10dp"
            app:layout_constraintTop_toBottomOf="@id/container_conversations_heading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:id="@+id/button_conversations_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:background="@drawable/bg_email_identification_input"
                android:foreground="@drawable/bg_home_row_ripple"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:fontFamily="@font/montserrat_family"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="54dp"
                    android:paddingVertical="12dp"
                    android:text="@string/conversations_search_hint"
                    android:textColor="@color/astro_input_hint"
                    android:textSize="@dimen/employee_home_body_text_size" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/conversations_search" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/container_conversations_filters"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="30dp"
            android:paddingVertical="10dp"
            app:layout_constraintTop_toBottomOf="@id/container_conversations_search"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/button_conversations_filter_all"
                style="@style/ConversationsFilter"
                android:text="@string/conversations_filter_all"
                tools:background="@color/astro_primary_purple" />

            <TextView
                android:id="@+id/button_conversations_filter_employees"
                style="@style/ConversationsFilter"
                android:layout_marginStart="10dp"
                android:text="@string/conversations_filter_employees" />

            <TextView
                android:id="@+id/button_conversations_filter_managers"
                style="@style/ConversationsFilter"
                android:layout_marginStart="10dp"
                android:text="@string/conversations_filter_managers" />
        </LinearLayout>

        <include
            android:id="@+id/button_conversations_ai"
            layout="@layout/include_conversation_ai"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/container_conversations_filters"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/divider_conversations_ai"
            android:layout_width="0dp"
            android:layout_height="21dp"
            android:background="@drawable/bg_home_divider"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toBottomOf="@id/button_conversations_ai"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_conversations"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/divider_conversations_ai"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <include
            android:id="@+id/container_conversations_skeleton"
            layout="@layout/view_conversations_skeleton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/divider_conversations_ai"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
