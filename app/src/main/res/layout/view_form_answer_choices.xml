<?xml version="1.0" encoding="utf-8"?>
<RadioGroup xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="30dp" android:paddingBottom="10dp" android:orientation="vertical">
    <androidx.appcompat.widget.AppCompatRadioButton android:id="@+id/radio_form_answer_ok"
        style="@style/FormAnswerOption" app:buttonCompat="@drawable/form_answer_choice_selector"
        app:buttonTint="@null" android:text="@string/form_answer_ok" />
    <androidx.appcompat.widget.AppCompatRadioButton android:id="@+id/radio_form_answer_problematic"
        style="@style/FormAnswerOption" app:buttonCompat="@drawable/form_answer_choice_selector"
        app:buttonTint="@null" android:text="@string/form_answer_problematic" />
</RadioGroup>
