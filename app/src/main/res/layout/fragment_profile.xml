<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/astro_dark_background"
    tools:context="com.example.astro_mobile.shared.profile.ProfileFragment">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintWidth_max="@dimen/employee_home_content_max_width"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <FrameLayout android:id="@+id/container_profile_header"
            android:layout_width="0dp" android:layout_height="80dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView style="@style/ProfileText" android:layout_height="match_parent"
                android:layout_marginHorizontal="65dp" android:gravity="center"
                android:text="@string/profile_title" android:textSize="24sp" />
            <ImageButton android:id="@+id/button_profile_back"
                android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="start|center_vertical" android:layout_marginStart="20dp"
                android:background="@drawable/bg_login_icon_button"
                android:paddingHorizontal="14dp" android:paddingVertical="16dp"
                android:scaleType="fitCenter" android:src="@drawable/ic_login_back"
                android:contentDescription="@string/profile_retry_back" />
        </FrameLayout>
        <ScrollView android:id="@+id/scroll_profile"
            android:layout_width="0dp" android:layout_height="0dp" android:visibility="invisible"
            android:clipToPadding="false" android:overScrollMode="ifContentScrolls"
            app:layout_constraintTop_toBottomOf="@id/container_profile_header"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="30dp" android:paddingBottom="30dp">
                <LinearLayout style="@style/ProfileField" android:paddingVertical="10dp">
                    <ImageView android:layout_width="54dp" android:layout_height="54dp"
                        android:layout_marginEnd="30dp" android:background="@drawable/bg_profile_avatar"
                        android:padding="14dp" android:src="@drawable/home_user"
                        android:contentDescription="@null" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/text_profile_name" style="@style/ProfileText"
                            android:textSize="@dimen/employee_home_heading_text_size" android:textStyle="bold"
                            tools:text="Kevin Parker" />
                        <LinearLayout style="@style/ProfileField" android:layout_marginTop="5dp">
                            <ImageView style="@style/ProfileFieldIcon" android:layout_marginEnd="10dp"
                                android:src="@drawable/profile_user_group" android:contentDescription="@null"
                                app:tint="@color/astro_light_background" />
                            <TextView android:id="@+id/text_profile_role" style="@style/ProfileText"
                                android:layout_width="0dp" android:layout_weight="1"
                                android:textStyle="bold" android:textColor="@color/astro_input_hint"
                                tools:text="Eletricista" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <View style="@style/ProfileDivider" />
                <LinearLayout style="@style/ProfileField" android:paddingVertical="20dp">
                    <ImageView style="@style/ProfileFieldIcon" android:src="@drawable/profile_building" android:contentDescription="@null"
                        app:tint="@color/astro_light_background" />
                    <TextView style="@style/ProfileFieldLabel" android:text="@string/profile_unit" />
                    <TextView android:id="@+id/text_profile_unit" style="@style/ProfileFieldValue" tools:text="Osasco" />
                </LinearLayout>
                <View style="@style/ProfileDivider" />
                <LinearLayout style="@style/ProfileField" android:paddingVertical="20dp">
                    <ImageView style="@style/ProfileFieldIcon" android:src="@drawable/profile_tag" android:contentDescription="@null"
                        app:tint="@color/astro_light_background" />
                    <TextView style="@style/ProfileFieldLabel" android:text="@string/profile_modality" />
                    <TextView android:id="@+id/text_profile_modality" style="@style/ProfileFieldValue" tools:text="Presencial" />
                </LinearLayout>
                <View style="@style/ProfileDivider" />
                <LinearLayout style="@style/ProfileField" android:paddingVertical="20dp">
                    <ImageView style="@style/ProfileFieldIcon" android:src="@drawable/ic_email_closed" android:contentDescription="@null"
                        app:tint="@color/astro_light_background" />
                    <TextView style="@style/ProfileFieldLabel" android:text="@string/profile_email" />
                    <TextView android:id="@+id/text_profile_email" style="@style/ProfileFieldValue"
                        android:breakStrategy="simple" tools:text="kevin.parker@picpay.com" />
                </LinearLayout>
                <View style="@style/ProfileDivider" />
                <LinearLayout style="@style/ProfileField" android:minHeight="56dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp">
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_profile_notifications"
                        android:layout_width="wrap_content" android:layout_height="48dp"
                        android:layout_marginEnd="15dp" android:contentDescription="@string/profile_notifications"
                        android:thumb="@drawable/profile_switch_thumb"
                        app:thumbTint="@color/astro_light_background"
                        app:track="@drawable/profile_switch_track" app:trackTint="@color/profile_switch_track_tint"
                        app:splitTrack="false" app:showText="false" app:switchMinWidth="63dp" />
                    <TextView style="@style/ProfileText" android:layout_width="0dp"
                        android:layout_weight="1" android:text="@string/profile_notifications" />
                </LinearLayout>
                <View style="@style/ProfileDivider" />
                <LinearLayout style="@style/ProfileField"
                    android:background="@drawable/bg_access_key_button" android:paddingHorizontal="30dp"
                    android:paddingVertical="20dp" android:layout_marginBottom="20dp">
                    <TextView style="@style/ProfileText" android:layout_width="0dp"
                        android:layout_weight="1" android:text="@string/profile_nrs" />
                    <ImageView style="@style/ProfileFieldIcon" android:layout_marginEnd="0dp"
                        android:src="@drawable/profile_shield" android:contentDescription="@null" />
                </LinearLayout>
                <!-- A lista curta de NRs acompanha a rolagem do perfil, sem uma segunda área de scroll. -->
                <LinearLayout android:id="@+id/list_profile_nrs"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include layout="@layout/item_profile_nr"
                        android:visibility="gone" tools:visibility="visible" />
                    <include layout="@layout/item_profile_nr"
                        android:visibility="gone" tools:visibility="visible" />
                </LinearLayout>
                <TextView android:id="@+id/text_profile_nrs_empty" style="@style/ProfileText"
                    android:text="@string/profile_nrs_empty" android:textColor="@color/astro_input_hint"
                    android:visibility="gone" />
                <TextView android:id="@+id/button_profile_change_password" style="@style/ProfileButton"
                    app:drawableStartCompat="@drawable/ic_profile_lock" android:text="@string/profile_change_password" />
                <TextView android:id="@+id/button_profile_switch_flow" style="@style/ProfileButton"
                    app:drawableStartCompat="@drawable/profile_switch_flow"
                    android:text="@string/profile_switch_flow" android:visibility="gone" tools:visibility="visible" />
                <TextView android:id="@+id/button_profile_logout" style="@style/ProfileButton"
                    android:background="@drawable/bg_profile_logout"
                    app:drawableStartCompat="@drawable/ic_profile_logout" app:drawableTint="#FF4D4D" android:textColor="#FF4D4D"
                    android:text="@string/profile_logout" />
            </LinearLayout>
        </ScrollView>
        <include android:id="@+id/container_profile_skeleton"
            layout="@layout/view_profile_skeleton" android:layout_width="0dp" android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/container_profile_header"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="gone" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
