<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_ai_session_row" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp"
        android:paddingHorizontal="@dimen/astro_content_margin" android:paddingVertical="12dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:baselineAligned="false">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="12dp"
            android:background="@drawable/bg_conversations_ai_avatar" android:padding="5dp" android:scaleType="fitCenter"
            android:src="@drawable/home_mascot" android:contentDescription="@null" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/text_ai_session_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_family" android:textSize="@dimen/employee_home_body_text_size"
                android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/astro_light_background"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/text_ai_session_preview" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_family" android:includeFontPadding="false"
                android:textSize="@dimen/employee_home_caption_text_size" android:textColor="@color/astro_input_hint" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/text_ai_session_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_family" android:includeFontPadding="false"
                android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/astro_input_hint" />
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="@dimen/astro_content_margin"
        android:background="@color/astro_input_background" android:importantForAccessibility="no" />
</LinearLayout>
