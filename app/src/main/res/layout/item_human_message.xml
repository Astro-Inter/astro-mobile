<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="16dp">
    <ImageView android:id="@+id/image_human_message_avatar" android:layout_width="37dp" android:layout_height="37dp"
        android:contentDescription="@null" android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="@id/container_human_message" />
    <LinearLayout android:id="@+id/container_human_message" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="21dp" android:paddingVertical="18dp"
        android:background="@drawable/bg_chat_user" app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout android:id="@+id/container_human_quote" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingVertical="8dp" android:visibility="gone" android:layout_marginBottom="10dp">
            <View android:layout_width="3dp" android:layout_height="match_parent" android:background="@color/chat_link" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="4dp">
                <TextView android:id="@+id/text_human_quote_author" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_family" android:textStyle="bold" android:textSize="12sp"
                    android:textColor="@color/chat_link" android:includeFontPadding="false"
                    android:singleLine="true" android:ellipsize="end" />
                <TextView android:id="@+id/text_human_quote_content" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_family" android:textSize="13sp"
                    android:textColor="@color/chat_muted" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/text_human_message_content" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_family" android:textSize="17sp" android:textColor="@color/chat_text"
            android:lineSpacingExtra="3dp" android:includeFontPadding="false" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginTop="2dp"
            android:layout_gravity="end" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/button_human_message_copy" android:layout_width="48dp" android:layout_height="28dp"
                android:background="@drawable/bg_login_icon_button" android:paddingHorizontal="14dp" android:paddingVertical="4dp" android:scaleType="centerInside"
                android:src="@drawable/ic_human_message_copy" app:tint="@color/chat_muted"
                android:contentDescription="@string/human_message_copy" android:tooltipText="@string/human_message_copy" />
            <TextView android:id="@+id/text_human_message_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:fontFamily="@font/montserrat_family"
                android:textSize="12sp" android:textColor="@color/chat_muted" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
