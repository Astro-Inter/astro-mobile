<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="30dp" android:importantForAccessibility="noHideDescendants">
    <View android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/bg_home_skeleton_block" />
    <View android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="20dp"
        android:background="@drawable/bg_home_skeleton_block" />
    <LinearLayout style="@style/ParticipantSkeletonRow" android:layout_marginTop="20dp">
        <View android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_profile_avatar" />
        <View android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1"
            android:layout_marginStart="20dp" android:background="@drawable/bg_home_skeleton_block" />
    </LinearLayout>
    <LinearLayout style="@style/ParticipantSkeletonRow">
        <View android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_profile_avatar" />
        <View android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1"
            android:layout_marginStart="20dp" android:background="@drawable/bg_home_skeleton_block" />
    </LinearLayout>
    <LinearLayout style="@style/ParticipantSkeletonRow">
        <View android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_profile_avatar" />
        <View android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1"
            android:layout_marginStart="20dp" android:background="@drawable/bg_home_skeleton_block" />
    </LinearLayout>
</LinearLayout>
