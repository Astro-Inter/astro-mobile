<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/astro_dark_background"
    tools:showIn="@layout/activity_main">

    <LinearLayout
        android:id="@+id/container_first_login_access_key_nav"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/button_first_login_access_key_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="15dp"
            android:background="@drawable/bg_auth_back_button"
            android:contentDescription="@string/first_login_access_key_back_description"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/container_first_login_access_key_nav">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="480dp"
            android:paddingBottom="160dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="30dp"
                android:paddingTop="10dp"
                android:paddingEnd="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="430dp">

                <TextView
                    android:id="@+id/text_first_login_access_key_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_family"
                    android:includeFontPadding="false"
                    android:text="@string/first_login_access_key_title"
                    android:textColor="@color/astro_light_text"
                    android:textSize="24sp" />

                <LinearLayout
                    android:id="@+id/container_first_login_access_key_digits"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:layout_marginTop="20dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/input_access_key_digit_1"
                        style="@style/AccessKeyDigitInput"
                        android:layout_marginEnd="3dp"
                        android:imeOptions="actionNext" />

                    <EditText
                        android:id="@+id/input_access_key_digit_2"
                        style="@style/AccessKeyDigitInput"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:imeOptions="actionNext" />

                    <EditText
                        android:id="@+id/input_access_key_digit_3"
                        style="@style/AccessKeyDigitInput"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:imeOptions="actionNext" />

                    <EditText
                        android:id="@+id/input_access_key_digit_4"
                        style="@style/AccessKeyDigitInput"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:imeOptions="actionNext" />

                    <EditText
                        android:id="@+id/input_access_key_digit_5"
                        style="@style/AccessKeyDigitInput"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:imeOptions="actionNext" />

                    <EditText
                        android:id="@+id/input_access_key_digit_6"
                        style="@style/AccessKeyDigitInput"
                        android:layout_marginStart="3dp"
                        android:imeOptions="actionDone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/text_first_login_access_key_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/montserrat_family"
                    android:includeFontPadding="false"
                    android:text="@string/first_login_access_key_error"
                    android:textColor="@color/astro_error"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <FrameLayout
                    android:id="@+id/button_first_login_access_key_continue"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_access_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/first_login_access_key_continue_description"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/montserrat_family"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/first_login_access_key_action"
                        android:textColor="@color/astro_light_background"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="17dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_arrow_right" />

                </FrameLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
