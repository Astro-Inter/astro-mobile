<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/astro_dark_background"
    tools:context="com.example.astro_mobile.manager.events.ManagerEventDetailsFragment">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintWidth_max="@dimen/employee_home_content_max_width"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/header_manager_event_details" android:layout_width="0dp"
            android:layout_height="80dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:baselineAligned="false" android:paddingHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageButton android:id="@+id/button_manager_event_back" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_back" android:paddingHorizontal="14dp"
                android:paddingVertical="16dp" android:src="@drawable/ic_login_back" android:scaleType="fitCenter" />
            <TextView style="@style/ManagerEventsText" android:layout_width="0dp" android:layout_weight="1"
                android:gravity="center" android:textSize="24sp" android:text="@string/employee_event_details_title" />
            <ImageButton android:id="@+id/button_manager_event_close" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_close" android:padding="14dp"
                android:src="@drawable/conversations_close" android:scaleType="fitCenter" />
        </LinearLayout>

        <ScrollView android:id="@+id/scroll_manager_event_details" android:layout_width="0dp"
            android:layout_height="0dp" android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/header_manager_event_details" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
                    android:padding="30dp">
                    <ImageView android:layout_width="79dp" android:layout_height="79dp"
                        android:src="@drawable/manager_event_badge" android:scaleType="fitCenter"
                        android:contentDescription="@null" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="20dp" android:orientation="vertical">
                        <TextView android:id="@+id/text_manager_event_title" style="@style/ManagerEventsText"
                            android:textSize="24sp" android:text="@string/manager_event_title_mock" />
                        <TextView android:id="@+id/text_manager_event_subtitle" style="@style/ManagerEventsText"
                            android:layout_marginTop="5dp" android:textColor="@color/astro_input_hint"
                            android:text="@string/manager_event_self_declaration" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginHorizontal="30dp" android:layout_marginVertical="10dp"
                    android:paddingHorizontal="30dp" android:paddingVertical="20dp" android:background="@drawable/bg_profile_panel">
                    <TextView style="@style/ManagerEventsText" android:text="@string/employee_event_about" />
                    <TextView style="@style/ManagerEventsText" android:layout_marginTop="5dp"
                        android:textColor="@color/astro_input_hint" android:text="@string/manager_event_description_mock" />
                </LinearLayout>
                <TextView style="@style/ManagerEventDetailsHeading" android:text="@string/employee_event_attachments" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30dp" android:layout_marginVertical="10dp">
                    <TextView android:id="@+id/button_manager_event_attachment" style="@style/EmployeeEventDetailsButton"
                        android:text="@string/employee_event_view_attachment" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_gravity="start|center_vertical" android:layout_marginStart="15dp"
                        android:src="@drawable/employee_event_link" android:scaleType="fitCenter"
                        android:contentDescription="@null" android:importantForAccessibility="no" />
                </FrameLayout>

                <!-- Apenas a autodeclaração tem os indicadores de validação. -->
                <LinearLayout android:id="@+id/container_manager_event_validations" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <View style="@style/ManagerEventDetailsDivider" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingHorizontal="30dp" android:paddingVertical="10dp">
                        <TextView style="@style/ManagerEventsText" android:textSize="24sp" android:text="@string/manager_event_validations" />
                        <TextView style="@style/ManagerEventsText" android:layout_marginTop="5dp"
                            android:textColor="@color/astro_input_hint" android:text="@string/manager_event_validations_description" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:baselineAligned="false"
                        android:paddingHorizontal="30dp" android:paddingVertical="10dp">
                        <LinearLayout style="@style/ManagerEventValidationCard">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                                <TextView style="@style/ManagerEventValidationCount" android:text="@string/manager_event_validations_pending_mock" />
                                <ImageView style="@style/ManagerEventValidationIcon" android:layout_width="20dp"
                                    android:src="@drawable/manager_event_eye" android:contentDescription="@null" />
                            </LinearLayout>
                            <TextView style="@style/ManagerEventValidationCaption" android:text="@string/manager_event_validations_pending" />
                        </LinearLayout>
                        <LinearLayout style="@style/ManagerEventValidationCard" android:layout_marginStart="10dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                                <TextView style="@style/ManagerEventValidationCount" android:text="@string/manager_event_validations_done_mock" />
                                <ImageView style="@style/ManagerEventValidationIcon" android:layout_width="20dp"
                                    android:layout_height="20dp" android:src="@drawable/home_check" android:contentDescription="@null" />
                            </LinearLayout>
                            <TextView style="@style/ManagerEventValidationCaption" android:text="@string/manager_event_validations_done" />
                        </LinearLayout>
                        <LinearLayout style="@style/ManagerEventValidationCard" android:layout_marginStart="10dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                                <TextView style="@style/ManagerEventValidationCount" android:text="@string/manager_event_conclusion_pending_mock" />
                                <ImageView style="@style/ManagerEventValidationIcon" android:src="@drawable/manager_event_hourglass"
                                    android:contentDescription="@null" />
                            </LinearLayout>
                            <TextView style="@style/ManagerEventValidationCaption" android:text="@string/manager_event_conclusion_pending" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/ManagerEventDetailsRow">
                    <ImageView style="@style/ManagerEventDetailsIcon" android:layout_width="20dp" android:layout_height="18dp"
                        android:src="@drawable/profile_user_group" app:tint="@color/astro_light_background" android:contentDescription="@null" />
                    <TextView style="@style/ManagerEventDetailsLabel" android:text="@string/manager_event_participants_label" />
                    <TextView style="@style/ManagerEventDetailsValue" android:text="@string/manager_event_participants_mock" />
                </LinearLayout>
                <View style="@style/ManagerEventDetailsDivider" />
                <TextView style="@style/ManagerEventDetailsHeading" android:text="@string/manager_event_information" />
                <LinearLayout style="@style/ManagerEventDetailsRow">
                    <ImageView style="@style/ManagerEventDetailsIcon" android:src="@drawable/home_calendar" android:contentDescription="@null" />
                    <TextView style="@style/ManagerEventDetailsLabel" android:text="@string/employee_event_deadline_label" />
                    <TextView style="@style/ManagerEventDetailsValue" android:text="@string/manager_event_deadline_mock" />
                </LinearLayout>
                <View style="@style/ManagerEventDetailsDivider" />
                <LinearLayout style="@style/ManagerEventDetailsRow">
                    <ImageView style="@style/ManagerEventDetailsIcon" android:src="@drawable/home_clock" android:contentDescription="@null" />
                    <TextView style="@style/ManagerEventDetailsLabel" android:text="@string/employee_event_validity_label" />
                    <TextView style="@style/ManagerEventDetailsValue" android:text="@string/manager_event_validity_mock" />
                </LinearLayout>
                <View style="@style/ManagerEventDetailsDivider" />
                <LinearLayout style="@style/ManagerEventDetailsRow" android:minHeight="80dp">
                    <ImageView style="@style/ManagerEventDetailsIcon" android:src="@drawable/employee_event_notes" android:contentDescription="@null" />
                    <TextView style="@style/ManagerEventDetailsLabel" android:text="@string/employee_event_completion_mode_label" />
                    <TextView android:id="@+id/text_manager_event_mode" style="@style/ManagerEventDetailsValue"
                        android:text="@string/employee_event_self_declaration" />
                </LinearLayout>
                <View style="@style/ManagerEventDetailsDivider" />
                <LinearLayout style="@style/ManagerEventDetailsRow">
                    <ImageView style="@style/ManagerEventDetailsIcon" android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/employee_event_user" android:contentDescription="@null" />
                    <TextView style="@style/ManagerEventDetailsLabel" android:text="@string/employee_event_sender_label" />
                    <TextView style="@style/ManagerEventDetailsValue" android:text="@string/manager_event_sender_mock" />
                </LinearLayout>
                <View style="@style/ManagerEventDetailsDivider" />
                <View style="@style/ManagerEventDetailsDivider" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30dp" android:layout_marginVertical="10dp">
                    <TextView android:id="@+id/button_manager_event_participants" style="@style/EmployeeEventDetailsButton"
                        android:background="@drawable/bg_login_password_button" android:text="@string/manager_event_view_participants" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical" android:layout_marginEnd="14dp"
                        android:src="@drawable/chat_send_arrow" android:scaleType="fitCenter"
                        android:contentDescription="@null" android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>
        </ScrollView>
        <!-- Oculto na prévia: o detalhe real continua visível no editor de XML. -->
        <include android:id="@+id/skeleton_manager_event_details" layout="@layout/view_manager_event_details_skeleton"
            android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/header_manager_event_details" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
