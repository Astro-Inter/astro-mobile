<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/astro_dark_background"
    tools:context="com.example.astro_mobile.manager.staff.events.StaffEventsFragment">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintWidth_max="@dimen/employee_home_content_max_width"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/header_staff_events" android:layout_width="0dp"
            android:layout_height="80dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:baselineAligned="false" android:paddingHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageButton android:id="@+id/button_staff_events_back" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_back" android:paddingHorizontal="14dp"
                android:paddingVertical="16dp" android:src="@drawable/ic_login_back" android:scaleType="fitCenter" />
            <TextView style="@style/ManagerEventsText" android:layout_width="0dp" android:layout_weight="1"
                android:gravity="center" android:textSize="24sp" android:text="@string/staff_events_title" />
            <ImageButton android:id="@+id/button_staff_events_close" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_close" android:padding="14dp"
                android:src="@drawable/conversations_close" android:scaleType="fitCenter" />
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/container_staff_events_content"
            android:layout_width="0dp" android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/header_staff_events" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:id="@+id/heading_staff_events" android:layout_width="0dp"
                android:layout_height="wrap_content" android:orientation="vertical" android:padding="30dp"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <TextView android:id="@+id/text_staff_events_heading" style="@style/ManagerEventsText"
                    android:textSize="24sp" tools:text="Eventos de Kevin Parker" />
                <TextView style="@style/ManagerEventsText" android:layout_marginTop="5dp"
                    android:textColor="@color/astro_input_hint" android:text="@string/staff_events_description" />
            </LinearLayout>
            <FrameLayout android:id="@+id/container_staff_events_dropdown" android:layout_width="0dp"
                android:layout_height="wrap_content" android:paddingHorizontal="30dp" android:paddingVertical="10dp"
                app:layout_constraintTop_toBottomOf="@id/heading_staff_events"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <TextView android:id="@+id/button_staff_events_filter" style="@style/ManagerEventsText"
                    android:minHeight="60dp" android:background="@drawable/bg_conversations_filter"
                    android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                    android:paddingStart="15dp" android:paddingEnd="55dp" android:paddingVertical="10dp"
                    android:text="@string/manager_events_filter" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical" android:layout_marginEnd="15dp"
                    android:src="@drawable/manager_events_chevron_down" android:scaleType="fitCenter"
                    android:contentDescription="@null" android:importantForAccessibility="no" />
            </FrameLayout>
            <View android:id="@+id/divider_staff_events_top" android:layout_width="0dp" android:layout_height="21dp"
                android:background="@drawable/bg_home_divider" android:importantForAccessibility="no"
                app:layout_constraintTop_toBottomOf="@id/container_staff_events_dropdown"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/list_staff_events"
                android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingBottom="30dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/divider_staff_events_top" app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_manager_event" tools:itemCount="3" />
            <TextView android:id="@+id/text_staff_events_empty" style="@style/ManagerEventsText"
                android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center"
                android:paddingHorizontal="30dp" android:visibility="gone" android:text="@string/employee_home_no_events"
                app:layout_constraintTop_toBottomOf="@id/divider_staff_events_top"
                app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!-- O conteúdo fica visível na prévia; o skeleton acompanha a requisição. -->
        <include android:id="@+id/skeleton_staff_events" layout="@layout/view_staff_events_skeleton"
            android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/header_staff_events" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
