<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_surface"
    tools:context="com.example.astro_mobile.chat.ChatFragment">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintWidth_max="@dimen/employee_home_content_max_width"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:paddingVertical="12dp">

            <ImageButton
                android:id="@+id/button_chat_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/chat_close"
                android:paddingHorizontal="14dp"
                android:paddingVertical="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_login_back" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_conversations_ai_avatar"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/chat_mascot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/montserrat_family"
                    android:includeFontPadding="false"
                    android:text="@string/chat_title"
                    android:textStyle="bold"
                    android:textColor="@color/astro_light_background"
                    android:textSize="@dimen/employee_home_body_text_size" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_family"
                    android:includeFontPadding="false"
                    android:text="@string/chat_subtitle"
                    android:textColor="@color/astro_input_hint"
                    android:textSize="@dimen/employee_home_caption_text_size" />
            </LinearLayout>
            <ImageButton android:id="@+id/button_chat_sessions"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_login_icon_button" android:padding="14dp" android:scaleType="fitCenter"
                android:src="@drawable/ai_sessions_menu" android:contentDescription="@string/ai_sessions_open" />
        </LinearLayout>

        <LinearLayout android:id="@+id/container_chat_session_actions"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:baselineAligned="false" android:layout_marginHorizontal="24dp" android:layout_marginBottom="8dp"
            android:paddingStart="16dp" android:paddingEnd="4dp" android:background="@drawable/bg_chat_session_toolbar"
            android:visibility="gone" tools:visibility="visible">
            <TextView android:id="@+id/text_chat_session_status" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp" android:layout_marginEnd="8dp" android:includeFontPadding="false"
                android:textColor="@color/astro_input_hint" android:fontFamily="@font/montserrat_family" android:textSize="12sp"
                android:accessibilityLiveRegion="polite" tools:text="@string/ai_sessions_status_active" />
            <ImageButton android:id="@+id/button_chat_session_action"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_login_icon_button" android:padding="14dp" android:scaleType="fitCenter"
                android:src="@drawable/ai_session_stop" android:contentDescription="@string/ai_sessions_end"
                android:tooltipText="@string/ai_sessions_end" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_chat_messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="30dp"
                android:paddingVertical="10dp"
                android:scrollbars="vertical"
                tools:listitem="@layout/item_chat_message"
                tools:itemCount="2" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/container_chat_welcome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:visibility="gone">

                <include layout="@layout/view_chat_welcome" />
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/container_chat_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="30dp"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <ProgressBar
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/chat_link" />

            <TextView
                android:id="@+id/text_chat_loading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/montserrat_family"
                android:text="@string/chat_loading"
                android:textColor="@color/chat_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_chat_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="30dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_chat_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/montserrat_family"
                android:text="@string/chat_generic_error"
                android:textColor="@color/astro_error"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_chat_retry"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:fontFamily="@font/montserrat_family"
                android:text="@string/chat_retry"
                android:textColor="@color/chat_link"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_chat_character_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="30dp"
            android:gravity="end"
            android:textSize="11sp"
            android:textColor="@color/chat_muted"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/container_chat_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="30dp"
            android:paddingVertical="20dp"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/button_chat_add"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/chat_add_attachment"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/chat_add" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input">

                <EditText
                    android:id="@+id/input_chat_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:maxLines="5"
                    android:gravity="start|center_vertical"
                    android:background="@null"
                    android:paddingStart="16dp"
                    android:paddingEnd="54dp"
                    android:paddingVertical="20dp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/montserrat_family"
                    android:hint="@string/chat_input_hint"
                    android:textColor="@color/chat_text"
                    android:textColorHint="@color/chat_muted"
                    android:textSize="@dimen/employee_home_body_text_size"
                    android:inputType="textCapSentences|textMultiLine"
                    android:imeOptions="actionSend"
                    android:importantForAutofill="no" />

                <ImageButton
                    android:id="@+id/button_chat_send"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_login_icon_button"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/chat_send_arrow"
                    android:contentDescription="@string/chat_send" />
            </FrameLayout>
        </LinearLayout>

        <include
            android:id="@+id/container_chat_bottom_nav"
            layout="@layout/include_conversations_bottom_nav" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
