<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/astro_dark_background"
    tools:context="com.example.astro_mobile.manager.events.participants.EventParticipantsFragment">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintWidth_max="@dimen/employee_home_content_max_width"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/header_event_participants" android:layout_width="0dp"
            android:layout_height="80dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:baselineAligned="false" android:paddingHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageButton android:id="@+id/button_participants_back" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_back" android:paddingHorizontal="14dp"
                android:paddingVertical="16dp" android:src="@drawable/ic_login_back" android:scaleType="fitCenter" />
            <TextView style="@style/ManagerEventsText" android:layout_width="0dp" android:layout_weight="1"
                android:gravity="center" android:textSize="24sp" android:text="@string/participants_title" />
            <ImageButton android:id="@+id/button_participants_close" android:layout_width="48dp"
                android:layout_height="48dp" android:background="@drawable/bg_login_icon_button"
                android:contentDescription="@string/conversations_close" android:padding="14dp"
                android:src="@drawable/conversations_close" android:scaleType="fitCenter" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/container_participants_content"
            android:layout_width="0dp" android:layout_height="0dp" android:focusableInTouchMode="true"
            app:layout_constraintTop_toBottomOf="@id/header_event_participants" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:id="@+id/heading_event_participants" android:layout_width="0dp"
                android:layout_height="wrap_content" android:orientation="vertical" android:padding="30dp"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <TextView style="@style/ManagerEventsText" android:textSize="24sp" android:text="@string/participants_heading" />
                <TextView android:id="@+id/text_participants_description" style="@style/ManagerEventsText"
                    android:layout_marginTop="5dp" android:textColor="@color/astro_input_hint"
                    tools:text="Acesse aqui o estado de cada colaborador participante em “Treinamento de EPI”" />
                <TextView android:id="@+id/text_participants_assignment_notice" style="@style/ManagerEventsText"
                    android:layout_marginTop="20dp" android:textColor="@color/astro_input_hint" android:textStyle="bold"
                    android:text="@string/participants_assignment_notice" android:visibility="gone" />
            </LinearLayout>
            <FrameLayout android:id="@+id/container_participants_search" android:layout_width="0dp"
                android:layout_height="wrap_content" android:paddingHorizontal="30dp" android:paddingVertical="10dp"
                app:layout_constraintTop_toBottomOf="@id/heading_event_participants"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <EditText android:id="@+id/input_participants_search" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="60dp"
                    android:background="@drawable/bg_email_identification_input"
                    android:hint="@string/participants_search" android:inputType="text" android:imeOptions="actionSearch"
                    android:singleLine="true" android:ellipsize="end" android:importantForAutofill="no"
                    android:fontFamily="@font/montserrat_family" android:paddingStart="16dp"
                    android:paddingEnd="54dp" android:paddingVertical="12dp" android:includeFontPadding="false"
                    android:textColor="@color/astro_light_background" android:textColorHint="@color/astro_input_hint"
                    android:textSize="16sp" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="16dp"
                    android:layout_gravity="end|center_vertical" android:src="@drawable/manager_events_search"
                    android:scaleType="fitCenter" android:contentDescription="@null" android:importantForAccessibility="no" />
            </FrameLayout>
            <LinearLayout android:id="@+id/container_participants_filters" android:layout_width="0dp"
                android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false"
                android:paddingHorizontal="30dp" android:paddingVertical="10dp"
                app:layout_constraintTop_toBottomOf="@id/container_participants_search"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                <TextView android:id="@+id/filter_participants_all" style="@style/ConversationsFilter"
                    android:padding="10dp" android:textSize="12sp" android:text="@string/employee_events_all"
                    tools:background="@color/astro_primary_purple" />
                <TextView android:id="@+id/filter_participants_finished" style="@style/ConversationsFilter"
                    android:layout_marginStart="10dp" android:padding="10dp" android:textSize="12sp"
                    android:text="@string/participants_validated" />
                <TextView android:id="@+id/filter_participants_not_finished" style="@style/ConversationsFilter"
                    android:layout_marginStart="10dp" android:padding="10dp" android:textSize="12sp"
                    android:text="@string/participants_not_validated" />
            </LinearLayout>
            <View android:id="@+id/divider_participants_top" android:layout_width="0dp" android:layout_height="21dp"
                android:background="@drawable/bg_home_divider" android:importantForAccessibility="no"
                app:layout_constraintTop_toBottomOf="@id/container_participants_filters"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/list_event_participants"
                android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingBottom="20dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/divider_participants_top" app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_event_participant" tools:itemCount="3" />
            <TextView android:id="@+id/text_participants_empty" style="@style/ManagerEventsText"
                android:layout_width="0dp" android:minHeight="80dp" android:gravity="center"
                android:padding="30dp" android:text="@string/participants_empty_mock" android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/divider_participants_top"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!-- O conteúdo real fica visível na prévia; o skeleton aparece apenas na espera mock. -->
        <include android:id="@+id/skeleton_event_participants" layout="@layout/view_event_participants_skeleton"
            android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/header_event_participants" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
