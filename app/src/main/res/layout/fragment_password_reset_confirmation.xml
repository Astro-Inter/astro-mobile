<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/astro_dark_background"
    tools:showIn="@layout/activity_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="24dp"
            android:paddingEnd="30dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/text_password_reset_confirmation_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/password_reset_confirmation_title"
                android:textColor="@color/astro_light_text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/text_password_reset_confirmation_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center"
                android:textColor="@color/astro_input_hint"
                android:textSize="16sp"
                tools:text="Se houver uma conta vinculada a este e-mail, enviaremos um link para redefinir sua senha: pessoa@exemplo.com" />

            <TextView
                android:id="@+id/button_password_reset_confirmation_email"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_login_password_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/montserrat_family"
                android:gravity="center"
                android:text="@string/password_reset_back_to_email"
                android:textColor="@color/astro_light_background"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
