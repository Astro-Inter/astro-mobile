<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.astro_mobile.navigation.SplashFragment"
        android:label="Splash">
        <action
            android:id="@+id/action_splash_to_mock_destination"
            app:destination="@id/mockDestinationFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/mockDestinationFragment"
        android:name="com.example.astro_mobile.navigation.MockDestinationFragment"
        android:label="Destino mock">
        <action
            android:id="@+id/action_mock_destination_to_access_key_information"
            app:destination="@id/accessKeyInformationFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_mock_destination_to_login_password"
            app:destination="@id/loginPasswordFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_mock_destination_to_first_login_access_key"
            app:destination="@id/firstLoginAccessKeyFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/accessKeyInformationFragment"
        android:name="com.example.astro_mobile.navigation.AccessKeyInformationFragment"
        android:label="Chave de acesso" />

    <fragment
        android:id="@+id/loginPasswordFragment"
        android:name="com.example.astro_mobile.navigation.LoginPasswordFragment"
        android:label="Login com senha">
        <action
            android:id="@+id/action_login_password_to_flow_choice"
            app:destination="@id/flowChoiceFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit"
            app:popUpTo="@id/mockDestinationFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/firstLoginAccessKeyFragment"
        android:name="com.example.astro_mobile.navigation.FirstLoginAccessKeyFragment"
        android:label="Chave do primeiro acesso">
        <action
            android:id="@+id/action_first_login_access_key_to_first_login_password"
            app:destination="@id/firstLoginPasswordFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/firstLoginPasswordFragment"
        android:name="com.example.astro_mobile.navigation.FirstLoginPasswordFragment"
        android:label="Definição da senha inicial">
        <action
            android:id="@+id/action_first_login_password_to_flow_choice"
            app:destination="@id/flowChoiceFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit"
            app:popUpTo="@id/mockDestinationFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/flowChoiceFragment"
        android:name="com.example.astro_mobile.navigation.FlowChoiceFragment"
        android:label="Escolha de fluxo">
        <action
            android:id="@+id/action_flow_choice_to_employee_home"
            app:destination="@id/employeeHomeFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit"
            app:popUpTo="@id/flowChoiceFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/employeeHomeFragment"
        android:name="com.example.astro_mobile.employee.home.EmployeeHomeFragment"
        android:label="Home do Colaborador" />

</navigation>
