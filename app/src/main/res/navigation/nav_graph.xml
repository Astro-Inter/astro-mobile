<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <action android:id="@+id/action_global_manager_events" app:destination="@id/managerEventsFragment"
        app:launchSingleTop="true" app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
        app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />

    <fragment android:id="@+id/managerEventsFragment"
        android:name="com.example.astro_mobile.manager.events.ManagerEventsFragment"
        android:label="Eventos do Gestor">
        <action android:id="@+id/action_manager_events_to_details" app:destination="@id/managerEventDetailsFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment android:id="@+id/managerEventDetailsFragment"
        android:name="com.example.astro_mobile.manager.events.ManagerEventDetailsFragment"
        android:label="Detalhes do evento do Gestor">
        <argument android:name="event_title" app:argType="string" />
        <argument android:name="event_completion_mode" app:argType="string" />
        <action android:id="@+id/action_manager_event_details_to_participants" app:destination="@id/eventParticipantsFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment android:id="@+id/eventParticipantsFragment"
        android:name="com.example.astro_mobile.manager.events.participants.EventParticipantsFragment"
        android:label="Participantes do evento">
        <argument android:name="event_title" app:argType="string" />
        <argument android:name="event_completion_mode" app:argType="string" />
        <action android:id="@+id/action_event_participants_to_assignment" app:destination="@id/eventAssignmentFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
        <action android:id="@+id/action_event_participants_to_validation" app:destination="@id/eventValidationFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment android:id="@+id/eventAssignmentFragment"
        android:name="com.example.astro_mobile.manager.events.assignment.EventAssignmentFragment"
        android:label="Atribuição de conclusão">
        <argument android:name="event_title" app:argType="string" />
        <argument android:name="participant_name" app:argType="string" />
        <argument android:name="participant_avatar_index" app:argType="integer" android:defaultValue="0" />
        <action android:id="@+id/action_assignment_to_confirmation" app:destination="@id/eventAssignmentConfirmationFragment"
            app:popUpTo="@id/eventAssignmentFragment" app:popUpToInclusive="true"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>
    <fragment android:id="@+id/eventAssignmentConfirmationFragment"
        android:name="com.example.astro_mobile.manager.events.assignment.EventAssignmentConfirmationFragment"
        android:label="Conclusão atribuída" />

    <action android:id="@+id/action_global_employee_events" app:destination="@id/employeeEventsFragment"
        app:launchSingleTop="true" app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
        app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />

    <fragment android:id="@+id/employeeEventsFragment"
        android:name="com.example.astro_mobile.employee.events.EmployeeEventsFragment" android:label="Eventos do Colaborador">
        <action android:id="@+id/action_employee_events_to_details" app:destination="@id/employeeEventDetailsFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <action android:id="@+id/action_global_employee_event_details" app:destination="@id/employeeEventDetailsFragment"
        app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
        app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />

    <fragment android:id="@+id/employeeEventDetailsFragment"
        android:name="com.example.astro_mobile.employee.events.EmployeeEventDetailsFragment"
        android:label="Detalhes do evento">
        <argument android:name="event_id" app:argType="long" />
        <action android:id="@+id/action_employee_event_details_to_confirmation"
            app:destination="@id/employeeEventConclusionFragment"
            app:popUpTo="@id/employeeEventDetailsFragment" app:popUpToInclusive="true"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment android:id="@+id/employeeEventConclusionFragment"
        android:name="com.example.astro_mobile.employee.events.EmployeeEventConclusionFragment"
        android:label="Conclusão de evento">
        <action android:id="@+id/action_employee_event_conclusion_to_home" app:destination="@id/employeeHomeFragment"
            app:popUpTo="@id/employeeHomeFragment" app:popUpToInclusive="true"
            app:enterAnim="@anim/push_pop_enter" app:exitAnim="@anim/push_pop_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <action android:id="@+id/action_global_conversations" app:destination="@id/conversationsFragment"
        app:launchSingleTop="true"
        app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
        app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    <action android:id="@+id/action_global_notifications" app:destination="@id/notificationsFragment"
        app:launchSingleTop="true"
        app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
        app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />

    <action android:id="@+id/action_global_profile" app:destination="@id/profileFragment"
        app:launchSingleTop="true"
        app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
        app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />

    <fragment android:id="@+id/profileFragment"
        android:name="com.example.astro_mobile.shared.profile.ProfileFragment" android:label="Perfil">
        <action android:id="@+id/action_profile_to_change_password" app:destination="@id/changePasswordFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
        <action android:id="@+id/action_profile_to_flow_choice" app:destination="@id/flowChoiceFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
        <action android:id="@+id/action_profile_to_generic_error" app:destination="@id/genericErrorFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>
    <fragment android:id="@+id/changePasswordFragment"
        android:name="com.example.astro_mobile.shared.profile.ChangePasswordFragment" android:label="Alterar senha">
        <action android:id="@+id/action_change_password_to_sent" app:destination="@id/passwordSentFragment"
            app:popUpTo="@id/changePasswordFragment" app:popUpToInclusive="true"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
        <action android:id="@+id/action_change_password_to_generic_error" app:destination="@id/genericErrorFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>
    <fragment android:id="@+id/passwordSentFragment"
        android:name="com.example.astro_mobile.shared.profile.PasswordSentFragment" android:label="E-mail enviado" />

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.astro_mobile.navigation.SplashFragment"
        android:label="Splash">
        <action android:id="@+id/action_splash_to_manager_home" app:destination="@id/managerHomeFragment"
            app:popUpTo="@id/splashFragment" app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_email_identification"
            app:destination="@id/emailIdentificationFragment"
            app:enterAnim="@anim/splash_dissolve_in"
            app:exitAnim="@anim/splash_dissolve_out"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_flow_choice"
            app:destination="@id/flowChoiceFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_employee_home"
            app:destination="@id/employeeHomeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_connection_error"
            app:destination="@id/connectionErrorFragment" />
        <action
            android:id="@+id/action_splash_to_first_login_password"
            app:destination="@id/firstLoginPasswordFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_generic_error"
            app:destination="@id/genericErrorFragment" />
    </fragment>

    <fragment
        android:id="@+id/emailIdentificationFragment"
        android:name="com.example.astro_mobile.navigation.EmailIdentificationFragment"
        android:label="Identificação de e-mail">
        <action
            android:id="@+id/action_email_identification_to_access_key_information"
            app:destination="@id/accessKeyInformationFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_email_identification_to_login_password"
            app:destination="@id/loginPasswordFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_email_identification_to_first_login_access_key"
            app:destination="@id/firstLoginAccessKeyFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_email_identification_to_first_login_password"
            app:destination="@id/firstLoginPasswordFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_email_identification_to_connection_error"
            app:destination="@id/connectionErrorFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_email_identification_to_generic_error"
            app:destination="@id/genericErrorFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/connectionErrorFragment"
        android:name="com.example.astro_mobile.navigation.ErrorFragment"
        android:label="Erro de conexão" />

    <fragment
        android:id="@+id/genericErrorFragment"
        android:name="com.example.astro_mobile.navigation.ErrorFragment"
        android:label="Erro genérico" />

    <fragment
        android:id="@+id/accessKeyInformationFragment"
        android:name="com.example.astro_mobile.navigation.AccessKeyInformationFragment"
        android:label="Chave de acesso" />

    <fragment
        android:id="@+id/loginPasswordFragment"
        android:name="com.example.astro_mobile.navigation.LoginPasswordFragment"
        android:label="Login com senha">
        <action
            android:id="@+id/action_login_password_to_flow_choice"
            app:destination="@id/flowChoiceFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit"
            app:popUpTo="@id/emailIdentificationFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_password_to_employee_home"
            app:destination="@id/employeeHomeFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit"
            app:popUpTo="@id/emailIdentificationFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_password_to_connection_error"
            app:destination="@id/connectionErrorFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_login_password_to_generic_error"
            app:destination="@id/genericErrorFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_login_password_to_reset_request"
            app:destination="@id/passwordResetRequestFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/passwordResetRequestFragment"
        android:name="com.example.astro_mobile.navigation.PasswordResetRequestFragment"
        android:label="Redefinição de senha">
        <action
            android:id="@+id/action_password_reset_request_to_confirmation"
            app:destination="@id/passwordResetConfirmationFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit"
            app:popUpTo="@id/loginPasswordFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_password_reset_request_to_connection_error"
            app:destination="@id/connectionErrorFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_password_reset_request_to_generic_error"
            app:destination="@id/genericErrorFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/passwordResetConfirmationFragment"
        android:name="com.example.astro_mobile.navigation.PasswordResetConfirmationFragment"
        android:label="Confirmação da redefinição" />

    <fragment
        android:id="@+id/firstLoginAccessKeyFragment"
        android:name="com.example.astro_mobile.navigation.FirstLoginAccessKeyFragment"
        android:label="Chave do primeiro acesso">
        <action
            android:id="@+id/action_first_login_access_key_to_first_login_password"
            app:destination="@id/firstLoginPasswordFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_first_login_access_key_to_connection_error"
            app:destination="@id/connectionErrorFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_first_login_access_key_to_generic_error"
            app:destination="@id/genericErrorFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/firstLoginPasswordFragment"
        android:name="com.example.astro_mobile.navigation.FirstLoginPasswordFragment"
        android:label="Definição da senha inicial">
        <action
            android:id="@+id/action_first_login_password_to_employee_home"
            app:destination="@id/employeeHomeFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit"
            app:popUpTo="@id/nav_graph" />
        <action
            android:id="@+id/action_first_login_password_to_connection_error"
            app:destination="@id/connectionErrorFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_first_login_password_to_generic_error"
            app:destination="@id/genericErrorFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/flowChoiceFragment"
        android:name="com.example.astro_mobile.navigation.FlowChoiceFragment"
        android:label="Escolha de fluxo">
        <action android:id="@+id/action_flow_choice_to_manager_home" app:destination="@id/managerHomeFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit"
            app:popUpTo="@id/flowChoiceFragment" app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_flow_choice_to_employee_home"
            app:destination="@id/employeeHomeFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit"
            app:popUpTo="@id/flowChoiceFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/employeeHomeFragment"
        android:name="com.example.astro_mobile.employee.home.EmployeeHomeFragment"
        android:label="Home do Colaborador">
        <action
            android:id="@+id/action_employee_home_to_chat"
            app:destination="@id/chatFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/conversationsFragment"
        android:name="com.example.astro_mobile.chat.ConversationsFragment"
        android:label="Conversas">
        <action android:id="@+id/action_conversations_to_new" app:destination="@id/newConversationFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
        <action android:id="@+id/action_conversations_to_ai_sessions" app:destination="@id/aiSessionsFragment" />
        <action android:id="@+id/action_conversations_to_human_chat"
            app:destination="@id/humanChatFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
        <action
            android:id="@+id/action_conversations_to_chat"
            app:destination="@id/chatFragment"
            app:enterAnim="@anim/push_enter"
            app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter"
            app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment android:id="@+id/newConversationFragment"
        android:name="com.example.astro_mobile.chat.ConversationsFragment"
        android:label="Nova conversa">
        <action android:id="@+id/action_new_conversation_to_human_chat" app:destination="@id/humanChatFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.example.astro_mobile.notifications.NotificationsFragment"
        android:label="Alertas">
        <action android:id="@+id/action_notifications_to_employee_event"
            app:destination="@id/employeeEventDetailsFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
        <action android:id="@+id/action_notifications_to_manager_event"
            app:destination="@id/managerEventDetailsFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment android:id="@+id/managerHomeFragment"
        android:name="com.example.astro_mobile.manager.home.ManagerHomeFragment" android:label="Home do Gestor">
        <action android:id="@+id/action_manager_home_to_forms" app:destination="@id/managerFormsFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
        <action android:id="@+id/action_manager_home_to_staff" app:destination="@id/staffFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
        <action android:id="@+id/action_manager_home_to_chat" app:destination="@id/chatFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment android:id="@+id/managerFormsFragment"
        android:name="com.example.astro_mobile.manager.forms.ManagerFormsFragment"
        android:label="Formulários">
        <action android:id="@+id/action_manager_forms_to_details" app:destination="@id/formDetailsFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment android:id="@+id/formDetailsFragment"
        android:name="com.example.astro_mobile.manager.forms.details.FormDetailsFragment"
        android:label="Detalhes do formulário">
        <action android:id="@+id/action_form_details_to_answer" app:destination="@id/formAnswerFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment android:id="@+id/eventValidationFragment"
        android:name="com.example.astro_mobile.manager.events.validation.EventValidationFragment"
        android:label="Validação de conclusão">
        <argument android:name="event_title" app:argType="string" />
        <argument android:name="participant_name" app:argType="string" />
        <argument android:name="participant_avatar_index" app:argType="integer" android:defaultValue="0" />
        <action android:id="@+id/action_event_validation_to_evidence" app:destination="@id/eventEvidenceFragment"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
        <action android:id="@+id/action_event_validation_to_confirmation" app:destination="@id/eventValidationConfirmationFragment"
            app:popUpTo="@id/eventValidationFragment" app:popUpToInclusive="true"
            app:enterAnim="@anim/push_enter" app:exitAnim="@anim/push_exit"
            app:popEnterAnim="@anim/push_pop_enter" app:popExitAnim="@anim/push_pop_exit" />
    </fragment>

    <fragment android:id="@+id/eventValidationConfirmationFragment"
        android:name="com.example.astro_mobile.manager.events.validation.EventValidationConfirmationFragment"
